<form class="{{cssClass}} add2e-objet-sheet" autocomplete="off" data-item-uuid="{{item.uuid}}">
  <style>
    .add2e-objet-sheet{--a2e-gold:#b8872d;--a2e-gold-dark:#765018;--a2e-ink:#322516;--a2e-paper:#f8f0dc;--a2e-paper-light:#fffaf0;display:flex;flex-direction:column;height:100%;gap:0;color:var(--a2e-ink)}
    .add2e-objet-sheet .add2e-magic-item-builder-panel,.add2e-objet-sheet .add2e-charged-spell-panel{display:none!important}
    .add2e-object-hero{display:grid;grid-template-columns:112px minmax(0,1fr);gap:14px;padding:12px;border:1px solid var(--a2e-gold);border-radius:10px 10px 0 0;background:linear-gradient(135deg,rgba(255,250,240,.96),rgba(227,211,174,.9));box-shadow:inset 0 0 0 1px rgba(255,255,255,.55)}
    .add2e-object-portrait{width:112px;height:112px;object-fit:cover;border:2px solid var(--a2e-gold-dark);border-radius:8px;background:#20180d;cursor:pointer;box-shadow:0 2px 7px rgba(50,30,10,.28)}
    .add2e-object-heading{display:flex;align-items:flex-start;gap:10px;margin-bottom:8px}.add2e-object-heading-main{flex:1;min-width:0}
    .add2e-object-kicker{font-size:.74rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase;color:var(--a2e-gold-dark)}
    .add2e-object-title{margin:2px 0 3px}.add2e-object-title input{height:38px;width:100%;border:0;border-bottom:2px solid var(--a2e-gold);border-radius:0;background:transparent;font-family:var(--font-h3);font-size:1.55rem;font-weight:900;color:var(--a2e-ink)}
    .add2e-object-subtitle{font-size:.84rem;opacity:.8}.add2e-state-badges{display:flex;flex-wrap:wrap;gap:6px;justify-content:flex-end}
    .add2e-check-pill{display:inline-flex;align-items:center;gap:6px;padding:6px 9px;border:1px solid #bca06a;border-radius:999px;background:rgba(255,255,255,.55);font-size:.8rem;font-weight:700;white-space:nowrap}.add2e-check-pill input{margin:0}
    .add2e-property-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}.add2e-field{display:grid;gap:3px}.add2e-field span{font-size:.72rem;font-weight:900;text-transform:uppercase;letter-spacing:.06em;color:#6d542d}.add2e-field input{height:34px;background:rgba(255,255,255,.63);border:1px solid #ac966c;border-radius:5px;padding:0 8px}
    .add2e-object-tabs{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;margin:0;border:1px solid var(--a2e-gold);border-top:0;background:rgba(103,73,29,.1)}.add2e-object-tabs .item{padding:9px 6px;text-align:center;border-right:1px solid rgba(118,80,24,.25);font-weight:800}.add2e-object-tabs .item:last-child{border-right:0}.add2e-object-tabs .item.active{background:var(--a2e-gold-dark);color:#fff8e7;text-shadow:0 1px 1px #000}
    .add2e-object-body{flex:1;min-height:0;overflow-y:auto;padding:12px;border:1px solid var(--a2e-gold);border-top:0;border-radius:0 0 10px 10px;background:rgba(255,250,240,.54)}
    .add2e-card{margin-bottom:12px;border:1px solid #c49a4b;border-radius:9px;background:rgba(255,250,240,.82);overflow:hidden;box-shadow:0 1px 3px rgba(70,44,10,.12)}.add2e-card:last-child{margin-bottom:0}
    .add2e-card-title{display:flex;align-items:center;gap:8px;margin:0;padding:8px 11px;background:linear-gradient(90deg,#765018,#b8872d);color:#fff8e7;font-size:.95rem;font-weight:900;text-transform:uppercase;letter-spacing:.05em}.add2e-card-title .value{margin-left:auto;font-size:.9rem;letter-spacing:0;text-transform:none}
    .add2e-card-content{padding:11px}.add2e-summary-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}
    .add2e-charge-top{display:grid;grid-template-columns:minmax(0,1fr) 110px;gap:10px;align-items:center}.add2e-charge-numbers{display:grid;grid-template-columns:1fr 1fr;gap:8px}.add2e-charge-total{text-align:center;font-size:1.25rem;font-weight:900;color:var(--a2e-gold-dark)}
    .add2e-charge-bar{height:14px;margin-top:9px;border:1px solid #73501e;border-radius:999px;background:#d8c9aa;overflow:hidden}.add2e-charge-bar>span{display:block;height:100%;width:calc(({{charges.value}} / {{#if charges.max}}{{charges.max}}{{else}}1{{/if}}) * 100%);max-width:100%;background:linear-gradient(90deg,#765018,#d49a32)}
    .add2e-recharge-box{display:grid;grid-template-columns:minmax(150px,.7fr) minmax(220px,1fr) auto;gap:9px;align-items:end;margin-top:12px;padding-top:10px;border-top:1px solid rgba(118,80,24,.35)}
    .add2e-recharge-status{display:flex;align-items:center;min-height:34px;padding:7px 10px;border:1px solid #c49a4b;border-radius:6px;background:#fffdf7;font-weight:700}.add2e-recharge-button{height:34px;white-space:nowrap;background:#765018;color:#fff8e7;border:1px solid #4d320c}
    .add2e-technical-fields{display:none}.add2e-section-title{display:flex;align-items:center;gap:7px;margin:0 0 9px;color:var(--a2e-gold-dark)}
    .add2e-arcane-drop-zone,.add2e-potion-spell-drop-zone,.add2e-magic-native-drop-zone{display:grid;place-items:center;min-height:86px;margin-top:10px;padding:14px;border:2px dashed #9b7434;border-radius:8px;background:#fff8e7;text-align:center;cursor:copy}.add2e-arcane-drop-zone.is-dragover,.add2e-potion-spell-drop-zone.is-dragover,.add2e-magic-native-drop-zone.is-dragover{border-color:#4d7e31;background:#eef7e7}
    .add2e-arcane-entry-list,.add2e-native-power-list{display:grid;gap:7px;margin:0;padding:0;list-style:none}.add2e-arcane-entry{display:grid;grid-template-columns:38px minmax(0,1fr) 75px 150px 42px;gap:8px;align-items:center;padding:7px;border:1px solid #d0b16b;border-radius:7px;background:#fffaf0}
    .add2e-native-power{border:1px solid #d0b16b;border-radius:8px;background:#fffaf0;overflow:hidden}.add2e-native-power summary{display:grid;grid-template-columns:38px minmax(0,1fr) auto 38px;gap:8px;align-items:center;padding:8px;cursor:pointer;list-style:none}.add2e-native-power summary::-webkit-details-marker{display:none}.add2e-native-power img{width:32px;height:32px;object-fit:cover;border:1px solid #8b6d2a;border-radius:5px}.add2e-native-power-description{padding:8px 12px;border-top:1px solid #d0b16b;background:#fffdf7}.add2e-native-power-cost{white-space:nowrap;font-weight:700}.add2e-native-power-remove{width:32px;height:30px;display:inline-flex;align-items:center;justify-content:center}
    .add2e-objet-rich-editor{min-height:150px;padding:9px;border:1px solid #d0b16b;border-radius:8px;background:#fffdf7}.add2e-objet-rich-editor .editor{min-height:170px}.add2e-objet-rich-editor .editor-content{min-height:150px}
    @media(max-width:700px){.add2e-object-hero{grid-template-columns:88px minmax(0,1fr)}.add2e-object-portrait{width:88px;height:88px}.add2e-property-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.add2e-summary-grid{grid-template-columns:1fr}.add2e-recharge-box{grid-template-columns:1fr}.add2e-state-badges{justify-content:flex-start}}
  </style>

  <header class="add2e-object-hero">
    <img class="add2e-object-portrait" src="{{img}}" data-edit="img" title="{{#if system.identifie}}{{item.name}}{{else}}{{system.nom_non_identifie}}{{/if}}">
    <div>
      <div class="add2e-object-heading">
        <div class="add2e-object-heading-main">
          <div class="add2e-object-kicker"><i class="fas fa-wand-magic-sparkles"></i> Objet magique</div>
          <h1 class="add2e-object-title">{{#if system.identifie}}<input name="name" type="text" value="{{item.name}}" placeholder="Nom">{{else}}<input type="text" value="{{#if system.nom_non_identifie}}{{system.nom_non_identifie}}{{else}}Objet magique{{/if}}" readonly><input name="name" type="hidden" value="{{item.name}}">{{/if}}</h1>
          <div class="add2e-object-subtitle">{{system.categorie}} · {{system.sousType}}{{#if system.rarete}} · {{system.rarete}}{{/if}}</div>
        </div>
        <div class="add2e-state-badges">
          <label class="add2e-check-pill"><input name="system.magique" type="checkbox" {{checked system.magique}}> Magique</label>
          <label class="add2e-check-pill"><input name="system.identifie" type="checkbox" {{checked system.identifie}}> Identifié</label>
          <label class="add2e-check-pill"><input name="system.maudit" type="checkbox" {{checked system.maudit}}> Maudit</label>
          <label class="add2e-check-pill"><input name="system.equipee" type="checkbox" {{checked system.equipee}}> Équipé</label>
        </div>
      </div>
      <div class="add2e-property-grid">
        <label class="add2e-field"><span>Catégorie</span><input name="system.categorie" type="text" value="{{system.categorie}}"></label>
        <label class="add2e-field"><span>Sous-type</span><input name="system.sousType" type="text" value="{{system.sousType}}"></label>
        <label class="add2e-field"><span>Rareté</span><input name="system.rarete" type="text" value="{{system.rarete}}"></label>
        <label class="add2e-field"><span>Quantité</span><input name="system.quantite" type="number" value="{{system.quantite}}"></label>
        <label class="add2e-field"><span>Poids / Prix</span><input name="system.poids" type="number" step="0.01" value="{{system.poids}}" title="Poids"><input name="system.prix" type="hidden" value="{{system.prix}}"></label>
      </div>
    </div>
  </header>

  <nav class="tabs sheet-tabs add2e-object-tabs" data-group="primary">
    <a class="item active" data-tab="resume"><i class="fas fa-scroll"></i> Résumé</a>
    {{#if isArcaneDocument}}<a class="item" data-tab="arcane"><i class="fas fa-book-open"></i> {{#if isSpellScrollDocument}}Sorts inscrits{{else}}Contenu{{/if}}</a>{{/if}}
    <a class="item" data-tab="pouvoirs"><i class="fas fa-wand-sparkles"></i> Pouvoirs</a>
    <a class="item" data-tab="effets"><i class="fas fa-burst"></i> Effets</a>
    <a class="item" data-tab="description"><i class="fas fa-feather"></i> Description</a>
  </nav>

  <section class="sheet-body add2e-object-body">
    <div class="content" data-tab="resume">
      <section class="add2e-card">
        <h3 class="add2e-card-title"><i class="fas fa-box-open"></i> Propriétés</h3>
        <div class="add2e-card-content add2e-summary-grid">
          <label class="add2e-field"><span>Quantité</span><input name="system.quantite" type="number" value="{{system.quantite}}"></label>
          <label class="add2e-field"><span>Poids</span><input name="system.poids" type="number" step="0.01" value="{{system.poids}}"></label>
          <label class="add2e-field"><span>Prix</span><input name="system.prix" type="text" value="{{system.prix}}"></label>
        </div>
      </section>

      <section class="add2e-card">
        <h3 class="add2e-card-title"><i class="fas fa-battery-three-quarters"></i> Charges <span class="value">{{charges.value}} / {{charges.max}}</span></h3>
        <div class="add2e-card-content">
          <div class="add2e-charge-top"><div class="add2e-charge-numbers"><label class="add2e-field"><span>Actuelles</span><input name="system.charges.value" type="number" value="{{charges.value}}"></label><label class="add2e-field"><span>Maximum</span><input name="system.charges.max" type="number" value="{{charges.max}}"></label></div><div class="add2e-charge-total">{{charges.value}} / {{charges.max}}</div></div>
          <div class="add2e-charge-bar" aria-label="Charges {{charges.value}} sur {{charges.max}}"><span></span></div>
          <div class="add2e-technical-fields"><input name="system.charges.mode" type="text" value="{{system.charges.mode}}"><input name="system.charges.recharge" type="text" value="{{system.charges.recharge}}"></div>
          {{#if system.charges.rechargeable}}
          <div class="add2e-recharge-box" data-recharge-control data-item-uuid="{{item.uuid}}">
            <label class="add2e-check-pill"><input name="system.charges.rechargeable" type="checkbox" {{checked system.charges.rechargeable}}> Rechargeable</label>
            <label class="add2e-field"><span>Recharge toutes les 24 h</span><input name="system.charges.rechargeFormula" type="text" value="{{#if system.charges.rechargeFormula}}{{system.charges.rechargeFormula}}{{else}}1d6{{/if}}"></label>
            <div class="add2e-recharge-status">Vérification du temps de recharge…</div>
            <button type="button" class="add2e-recharge-button" style="display:none"><i class="fas fa-battery-half"></i> Recharger</button>
            <img src="icons/svg/clockwork.svg" alt="" style="display:none" onload="(()=>{const box=this.closest('[data-recharge-control]');if(!box||box.dataset.bound==='1')return;box.dataset.bound='1';const status=box.querySelector('.add2e-recharge-status');const button=box.querySelector('.add2e-recharge-button');const uuid=box.dataset.itemUuid;const refresh=async()=>{const item=await fromUuid(uuid).catch(()=>null);if(!item)return;const now=Number(game.time?.worldTime??0)||0;let anchor=Number(item.getFlag?.('add2e','lastMagicItemRechargeWorldTime'));if(!Number.isFinite(anchor)){anchor=now;await item.setFlag?.('add2e','lastMagicItemRechargeWorldTime',anchor);}const current=Number(item.system?.charges?.value??0)||0;const max=Number(item.system?.charges?.max??0)||0;const remaining=Math.max(0,86400-(now-anchor));const ready=remaining<=0&&current<max;button.style.display=ready?'inline-flex':'none';status.textContent=current>=max?'Charges au maximum':ready?'Recharge disponible':`Disponible dans ${Math.ceil(remaining/3600)} h de temps de monde`;};button.addEventListener('click',async ev=>{ev.preventDefault();ev.stopPropagation();const item=await fromUuid(uuid).catch(()=>null);if(!item)return;const now=Number(game.time?.worldTime??0)||0;const last=Number(item.getFlag?.('add2e','lastMagicItemRechargeWorldTime'));if(Number.isFinite(last)&&now-last<86400){ui.notifications.warn('La recharge nécessite 24 heures de temps de monde.');return;}const formula=String(item.system?.charges?.rechargeFormula||'1d6').trim()||'1d6';const roll=await(new Roll(formula)).evaluate();const oldValue=Math.max(0,Number(item.system?.charges?.value??0)||0);const max=Math.max(0,Number(item.system?.charges?.max??0)||0);const gain=Math.max(0,Math.trunc(Number(roll.total)||0));const next=Math.min(max,oldValue+gain);await item.update({'system.charges.value':next,'flags.add2e.lastMagicItemRechargeWorldTime':now},{add2eInternal:true,add2eMagicRecharge:true,render:false});await ChatMessage.create({speaker:ChatMessage.getSpeaker({actor:item.parent??null}),content:`<div class='add2e-card'><h3><i class='fas fa-battery-half'></i> Recharge de ${item.name}</h3><p><b>Jet :</b> ${formula} = ${gain}</p><p><b>Charges :</b> ${oldValue} → ${next} / ${max}</p></div>`});ui.notifications.info(`${item.name} récupère ${next-oldValue} charge(s).`);item.sheet?.render?.({force:true});});refresh();})()">
          </div>
          {{/if}}
        </div>
      </section>

      <section class="add2e-card"><h3 class="add2e-card-title"><i class="fas fa-bullseye"></i> Activation</h3><div class="add2e-card-content add2e-summary-grid"><label class="add2e-field"><span>Activation</span><input name="system.activation" type="text" value="{{system.activation}}"></label><label class="add2e-field"><span>Cible</span><input name="system.cible" type="text" value="{{system.cible}}"></label><label class="add2e-field"><span>Durée</span><input name="system.duree" type="text" value="{{system.duree}}"></label></div></section>
    </div>

    {{#if isArcaneDocument}}<div class="content hidden" data-tab="arcane"><section class="add2e-card"><h3 class="add2e-card-title"><i class="fas fa-book-open"></i> {{#if isSpellScrollDocument}}Parchemin de sort{{else}}Livre de sorts{{/if}} <span class="value">{{arcaneSpellListLabel}}</span></h3><div class="add2e-card-content">{{#if arcaneEntries.length}}<ol class="add2e-arcane-entry-list">{{#each arcaneEntries as |entry|}}<li class="add2e-arcane-entry" data-spell-key="{{entry.key}}"><img src="{{entry.img}}" alt="{{entry.name}}" width="34" height="34"><div><b>{{entry.name}}</b></div><div>Niv. {{entry.level}}</div><div>{{entry.listLabel}}</div><div>{{#if ../canManageArcaneEntries}}<button type="button" class="add2e-arcane-remove-entry" data-spell-key="{{entry.key}}" title="Retirer cette inscription"><i class="fas fa-trash"></i></button>{{/if}}</div></li>{{/each}}</ol>{{else}}<p><em>Aucun sort inscrit.</em></p>{{/if}}{{#if canManageArcaneEntries}}<div class="add2e-arcane-drop-zone" tabindex="0"><div><i class="fas fa-scroll fa-2x"></i><p><b>Déposez ici un sort</b></p></div></div>{{/if}}</div></section></div>{{/if}}

    <div class="content hidden" data-tab="pouvoirs"><section class="add2e-card"><h3 class="add2e-card-title"><i class="fas fa-wand-magic-sparkles"></i> Pouvoirs et sorts <span class="value">Charges : {{charges.value}}/{{charges.max}}</span></h3><div class="add2e-card-content">{{#if pouvoirs.length}}<ol class="add2e-native-power-list">{{#each pouvoirs as |p idx|}}<li class="add2e-native-power"><details><summary><img src="{{#if p.img}}{{p.img}}{{else}}icons/svg/aura.svg{{/if}}" alt=""><strong>{{#if p.name}}{{p.name}}{{else}}{{p.nom}}{{/if}}</strong><span class="add2e-native-power-cost">Coût : {{#if p.cout}}{{p.cout}}{{else}}{{p.cost}}{{/if}}</span><button type="button" class="add2e-native-power-remove" data-power-index="{{idx}}" title="Retirer ce pouvoir" onclick="event.preventDefault();event.stopPropagation();(async()=>{const item=await fromUuid(this.closest('form').dataset.itemUuid).catch(()=>null);if(item&&await globalThis.add2eRemoveMagicItemPower?.(item,Number(this.dataset.powerIndex)))item.sheet?.render?.({force:true});})().catch(error=>{console.error('[ADD2E][OBJET_MAGIQUE][REMOVE_ERROR]',error);ui.notifications.error(error?.message||'Erreur pendant le retrait du pouvoir.');});"><i class="fas fa-trash"></i></button></summary><div class="add2e-native-power-description">{{#if p.description}}{{{p.description}}}{{else}}<em>Aucune description disponible.</em>{{/if}}</div></details></li>{{/each}}</ol>{{else}}<p style="text-align:center"><em>Aucun pouvoir ni sort configuré.</em></p>{{/if}}{{#unless isArcaneDocument}}{{#unless (eq (lowercase system.sousType) "potion")}}<div class="add2e-magic-native-drop-zone" tabindex="0" ondragenter="event.preventDefault();this.classList.add('is-dragover');" ondragover="event.preventDefault();event.stopPropagation();if(event.dataTransfer)event.dataTransfer.dropEffect='copy';this.classList.add('is-dragover');" ondragleave="this.classList.remove('is-dragover');" ondrop="event.preventDefault();event.stopPropagation();this.classList.remove('is-dragover');(async()=>{const item=await fromUuid(this.closest('form').dataset.itemUuid).catch(()=>null);if(!item)return;let data=null;const editor=foundry?.applications?.ux?.TextEditor?.implementation??globalThis.TextEditor;try{data=editor?.getDragEventData?.(event)??null;}catch(_e){}if(!data){try{data=JSON.parse(event.dataTransfer?.getData('text/plain')||'null');}catch(_e){}}let spell=null;if(data?.uuid)spell=await fromUuid(data.uuid).catch(()=>null);if(!spell&&CONFIG?.Item?.documentClass?.fromDropData)spell=await CONFIG.Item.documentClass.fromDropData(data).catch(()=>null);if(!spell){ui.notifications.warn('Le sort déposé est introuvable.');return;}if(await globalThis.add2eStoreSpellInMagicItem?.(item,spell))item.sheet?.render?.({force:true});})().catch(error=>{console.error('[ADD2E][OBJET_MAGIQUE][DROP_ERROR]',error);ui.notifications.error(error?.message||'Erreur pendant l’ajout du sort.');});"><div><i class="fas fa-wand-magic-sparkles fa-2x"></i><p><b>Déposez un sort ici</b></p><p>Le coût en charges sera demandé avant l’ajout.</p></div></div>{{/unless}}{{/unless}}{{#if (eq (lowercase system.sousType) "potion")}}<fieldset class="add2e-potion-spell-manager" data-item-uuid="{{item.uuid}}"><legend>Contenu de la potion</legend><div class="add2e-potion-spell-drop-zone" tabindex="0"><div><i class="fas fa-flask fa-2x"></i><p><b>Déposez ici le sort à placer dans la potion</b></p></div></div></fieldset>{{/if}}</div></section></div>

    <div class="content hidden" data-tab="effets"><section class="add2e-card"><h3 class="add2e-card-title"><i class="fas fa-tags"></i> Effets et marqueurs</h3><div class="add2e-card-content"><label class="add2e-field"><span>Tags</span><textarea name="system.tags" rows="4">{{#each tags}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</textarea></label><label class="add2e-field" style="margin-top:10px"><span>Effect tags</span><textarea name="system.effectTags" rows="4">{{#each effectTags}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</textarea></label></div></section></div>
    <div class="content hidden" data-tab="description"><section class="add2e-card"><h3 class="add2e-card-title"><i class="fas fa-feather"></i> Description</h3><div class="add2e-card-content"><div class="add2e-objet-rich-editor">{{editor system.description target="system.description" button=true editable=editable engine="prosemirror"}}</div></div></section></div>
  </section>
</form>