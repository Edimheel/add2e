<form class="{{cssClass}} add2e-objet-sheet" autocomplete="off" data-item-uuid="{{item.uuid}}">
  <style>
    .add2e-objet-sheet{--a2e-border:#b88a2b;--a2e-dark:#3b2a10;--a2e-paper:#fffaf0;--a2e-paper-2:#fffdf7;}
    .add2e-objet-sheet .add2e-magic-item-builder-panel,.add2e-objet-sheet .add2e-charged-spell-panel{display:none!important;}
    .add2e-objet-description-preview,.add2e-objet-rich-editor{min-height:110px;padding:8px 10px;border:1px solid #d0b16b;border-radius:8px;background:#fffdf7;color:#2f241c;line-height:1.35;}
    .add2e-objet-description-preview p,.add2e-objet-rich-editor p{margin:0 0 .55em}.add2e-objet-description-preview p:last-child,.add2e-objet-rich-editor p:last-child{margin-bottom:0}
    .add2e-objet-rich-editor .editor{min-height:140px}.add2e-objet-rich-editor .editor-content{min-height:120px}
    .add2e-arcane-drop-zone,.add2e-potion-spell-drop-zone,.add2e-magic-native-drop-zone{display:grid;place-items:center;min-height:88px;margin-top:10px;padding:14px;border:2px dashed #9b7434;border-radius:8px;background:#fff8e7;text-align:center;cursor:copy;transition:background .12s ease,border-color .12s ease}
    .add2e-arcane-drop-zone.is-dragover,.add2e-potion-spell-drop-zone.is-dragover,.add2e-magic-native-drop-zone.is-dragover{border-color:#4d7e31;background:#eef7e7}
    .add2e-arcane-entry-list,.add2e-native-power-list{display:grid;gap:7px;margin:0;padding:0;list-style:none}
    .add2e-arcane-entry{display:grid;grid-template-columns:38px minmax(0,1fr) 75px 150px 42px;gap:8px;align-items:center;padding:7px;border:1px solid #d0b16b;border-radius:7px;background:#fffaf0}
    .add2e-native-power{border:1px solid #d0b16b;border-radius:8px;background:#fffaf0;overflow:hidden}
    .add2e-native-power summary{display:grid;grid-template-columns:38px minmax(0,1fr) auto 38px;gap:8px;align-items:center;padding:8px;cursor:pointer;list-style:none}
    .add2e-native-power summary::-webkit-details-marker{display:none}.add2e-native-power img{width:32px;height:32px;object-fit:cover;border:1px solid #8b6d2a;border-radius:5px}
    .add2e-native-power-description{padding:8px 12px;border-top:1px solid #d0b16b;background:#fffdf7}.add2e-native-power-cost{white-space:nowrap;font-weight:700}
    .add2e-native-power-remove{width:32px;height:30px;display:inline-flex;align-items:center;justify-content:center}
    .add2e-recharge-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.add2e-recharge-extra{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr) auto;gap:8px;align-items:end;margin-top:8px}
    .add2e-recharge-status{padding:7px 9px;border:1px solid #d0b16b;border-radius:6px;background:#fffdf7;min-height:34px}.add2e-recharge-button{height:34px;white-space:nowrap}
    .add2e-section-title{display:flex;align-items:center;gap:7px;margin:0 0 8px;color:var(--a2e-dark)}
  </style>
  <header class="sheet-header" style="display:flex;gap:12px;align-items:flex-start;margin-bottom:10px;">
    <img class="profile-img" src="{{img}}" data-edit="img" title="{{#if system.identifie}}{{item.name}}{{else}}{{system.nom_non_identifie}}{{/if}}" width="96" height="96" style="object-fit:cover;border:1px solid #7a5a28;border-radius:6px;cursor:pointer;"/>
    <div class="header-fields" style="flex:1;display:grid;gap:6px;">
      <h1 style="margin:0;">
        {{#if system.identifie}}<input name="name" type="text" value="{{item.name}}" placeholder="Nom" style="width:100%;font-size:1.25rem;font-weight:700;"/>
        {{else}}<input type="text" value="{{#if system.nom_non_identifie}}{{system.nom_non_identifie}}{{else}}Objet magique{{/if}}" readonly aria-label="Nom non identifié" style="width:100%;font-size:1.25rem;font-weight:700;"/><input name="name" type="hidden" value="{{item.name}}"/>{{/if}}
      </h1>
      <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;">
        <label><span>Catégorie</span><input name="system.categorie" type="text" value="{{system.categorie}}"/></label>
        <label><span>Sous-type</span><input name="system.sousType" type="text" value="{{system.sousType}}"/></label>
        <label><span>Rareté</span><input name="system.rarete" type="text" value="{{system.rarete}}"/></label>
      </div>
      <div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;align-items:end;">
        <label><span>Quantité</span><input name="system.quantite" type="number" value="{{system.quantite}}"/></label>
        <label><span>Poids</span><input name="system.poids" type="number" step="0.01" value="{{system.poids}}"/></label>
        <label><span>Prix</span><input name="system.prix" type="text" value="{{system.prix}}"/></label>
        <label style="display:flex;gap:6px;align-items:center;margin-top:18px;"><input name="system.equipee" type="checkbox" {{checked system.equipee}}/> Équipé</label>
      </div>
    </div>
  </header>

  <nav class="tabs sheet-tabs" data-group="primary" style="display:flex;gap:6px;margin:8px 0;border-bottom:1px solid #b89b5e;">
    <a class="item active" data-tab="resume">Résumé</a>
    {{#if isArcaneDocument}}<a class="item" data-tab="arcane">{{#if isSpellScrollDocument}}Sorts inscrits{{else}}Contenu du livre{{/if}}</a>{{/if}}
    <a class="item" data-tab="pouvoirs">Pouvoirs</a><a class="item" data-tab="effets">Effets</a><a class="item" data-tab="description">Description</a>
  </nav>

  <section class="sheet-body" style="min-height:260px;">
    <div class="content" data-tab="resume">
      <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;">
        <label><span>Magique</span><input name="system.magique" type="checkbox" {{checked system.magique}}/></label>
        <label><span>Identifié</span><input name="system.identifie" type="checkbox" {{checked system.identifie}}/></label>
        <label><span>Maudit</span><input name="system.maudit" type="checkbox" {{checked system.maudit}}/></label>
      </div>
      <fieldset style="margin-top:10px;border:1px solid #d0b16b;border-radius:6px;"><legend>Charges</legend>
        <div class="add2e-recharge-grid">
          <label><span>Actuelles</span><input name="system.charges.value" type="number" value="{{charges.value}}"/></label>
          <label><span>Maximum</span><input name="system.charges.max" type="number" value="{{charges.max}}"/></label>
          <label><span>Mode</span><input name="system.charges.mode" type="text" value="{{system.charges.mode}}"/></label>
          <label><span>Recharge</span><input name="system.charges.recharge" type="text" value="{{system.charges.recharge}}"/></label>
        </div>
        {{#if system.charges.rechargeable}}
        <div class="add2e-recharge-extra" data-recharge-control data-item-uuid="{{item.uuid}}">
          <label><span>Rechargeable</span><input name="system.charges.rechargeable" type="checkbox" {{checked system.charges.rechargeable}}/></label>
          <label><span>Formule par 24 h</span><input name="system.charges.rechargeFormula" type="text" value="{{#if system.charges.rechargeFormula}}{{system.charges.rechargeFormula}}{{else}}1d6{{/if}}"/></label>
          <div class="add2e-recharge-status">Vérification du temps de recharge…</div>
          <button type="button" class="add2e-recharge-button" style="display:none"><i class="fas fa-battery-half"></i> Recharger</button>
          <img src="icons/svg/clockwork.svg" alt="" style="display:none" onload="(()=>{const box=this.closest('[data-recharge-control]');if(!box||box.dataset.bound==='1')return;box.dataset.bound='1';const status=box.querySelector('.add2e-recharge-status');const button=box.querySelector('.add2e-recharge-button');const uuid=box.dataset.itemUuid;const refresh=async()=>{const item=await fromUuid(uuid).catch(()=>null);if(!item)return;const now=Number(game.time?.worldTime??0)||0;let anchor=Number(item.getFlag?.('add2e','lastMagicItemRechargeWorldTime'));if(!Number.isFinite(anchor)){anchor=now;await item.setFlag?.('add2e','lastMagicItemRechargeWorldTime',anchor);}const current=Number(item.system?.charges?.value??0)||0;const max=Number(item.system?.charges?.max??0)||0;const remaining=Math.max(0,86400-(now-anchor));const ready=remaining<=0&&current<max;button.style.display=ready?'inline-flex':'none';status.textContent=current>=max?'Charges déjà au maximum.':ready?'Recharge disponible.':`Disponible dans ${Math.ceil(remaining/3600)} h de temps de monde.`;};button.addEventListener('click',async ev=>{ev.preventDefault();ev.stopPropagation();const item=await fromUuid(uuid).catch(()=>null);if(!item)return;const now=Number(game.time?.worldTime??0)||0;const last=Number(item.getFlag?.('add2e','lastMagicItemRechargeWorldTime'));if(Number.isFinite(last)&&now-last<86400){ui.notifications.warn('La recharge nécessite 24 heures de temps de monde.');return;}const formula=String(item.system?.charges?.rechargeFormula||'1d6').trim()||'1d6';const roll=await(new Roll(formula)).evaluate();const oldValue=Math.max(0,Number(item.system?.charges?.value??0)||0);const max=Math.max(0,Number(item.system?.charges?.max??0)||0);const gain=Math.max(0,Math.trunc(Number(roll.total)||0));const next=Math.min(max,oldValue+gain);await item.update({'system.charges.value':next,'flags.add2e.lastMagicItemRechargeWorldTime':now},{add2eInternal:true,add2eMagicRecharge:true,render:false});await ChatMessage.create({speaker:ChatMessage.getSpeaker({actor:item.parent??null}),content:`<div class='add2e-card'><h3><i class='fas fa-battery-half'></i> Recharge de ${item.name}</h3><p><b>Jet :</b> ${formula} = ${gain}</p><p><b>Charges :</b> ${oldValue} → ${next} / ${max}</p></div>`});ui.notifications.info(`${item.name} récupère ${next-oldValue} charge(s).`);item.sheet?.render?.({force:true});});refresh();})()"/>
        </div>
        {{/if}}
      </fieldset>
      <fieldset style="margin-top:10px;border:1px solid #d0b16b;border-radius:6px;"><legend>Activation</legend><div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;"><label><span>Activation</span><input name="system.activation" type="text" value="{{system.activation}}"/></label><label><span>Cible</span><input name="system.cible" type="text" value="{{system.cible}}"/></label><label><span>Durée</span><input name="system.duree" type="text" value="{{system.duree}}"/></label></div></fieldset>
    </div>

    {{#if isArcaneDocument}}<div class="content hidden" data-tab="arcane"><fieldset style="border:1px solid #d0b16b;border-radius:7px;padding:10px;"><legend>{{#if isSpellScrollDocument}}Parchemin de sort{{else}}Livre de sorts{{/if}}</legend><p style="margin-top:0;"><b>Liste :</b> {{arcaneSpellListLabel}}</p>{{#if arcaneEntries.length}}<ol class="add2e-arcane-entry-list">{{#each arcaneEntries as |entry|}}<li class="add2e-arcane-entry" data-spell-key="{{entry.key}}"><img src="{{entry.img}}" alt="{{entry.name}}" width="34" height="34" style="object-fit:cover;border-radius:5px;"><div><b>{{entry.name}}</b></div><div>Niv. {{entry.level}}</div><div>{{entry.listLabel}}</div><div>{{#if ../canManageArcaneEntries}}<button type="button" class="add2e-arcane-remove-entry" data-spell-key="{{entry.key}}" title="Retirer cette inscription" style="width:34px;height:30px;"><i class="fas fa-trash"></i></button>{{/if}}</div></li>{{/each}}</ol>{{else}}<p><em>Aucun sort inscrit.</em></p>{{/if}}{{#if canManageArcaneEntries}}<div class="add2e-arcane-drop-zone" tabindex="0"><div><i class="fas fa-scroll" style="font-size:1.5rem;"></i><p style="margin:6px 0 0;"><b>Déposez ici un sort</b></p><p style="margin:3px 0 0;">Depuis le compendium des sorts ou depuis la liste des sorts connus d'un acteur.</p></div></div>{{/if}}</fieldset></div>{{/if}}

    <div class="content hidden" data-tab="pouvoirs">
      <h3 class="add2e-section-title"><i class="fas fa-wand-magic-sparkles"></i> Pouvoirs et sorts de l’objet <span style="margin-left:auto;font-size:.85em;">Charges : {{charges.value}}/{{charges.max}}</span></h3>
      {{#if pouvoirs.length}}<ol class="add2e-native-power-list">{{#each pouvoirs as |p idx|}}<li class="add2e-native-power"><details><summary><img src="{{#if p.img}}{{p.img}}{{else}}icons/svg/aura.svg{{/if}}" alt=""><strong>{{#if p.name}}{{p.name}}{{else}}{{p.nom}}{{/if}}</strong><span class="add2e-native-power-cost">Coût : {{#if p.cout}}{{p.cout}}{{else}}{{p.cost}}{{/if}}</span><button type="button" class="add2e-native-power-remove" data-power-index="{{idx}}" title="Retirer ce pouvoir" onclick="event.preventDefault();event.stopPropagation();(async()=>{const item=await fromUuid(this.closest('form').dataset.itemUuid).catch(()=>null);if(item&&await globalThis.add2eRemoveMagicItemPower?.(item,Number(this.dataset.powerIndex)))item.sheet?.render?.({force:true});})().catch(error=>{console.error('[ADD2E][OBJET_MAGIQUE][REMOVE_ERROR]',error);ui.notifications.error(error?.message||'Erreur pendant le retrait du pouvoir.');});"><i class="fas fa-trash"></i></button></summary><div class="add2e-native-power-description">{{#if p.description}}{{{p.description}}}{{else}}<em>Aucune description disponible.</em>{{/if}}</div></details></li>{{/each}}</ol>{{else}}<p class="a2e-muted" style="text-align:center;padding:12px;border:1px solid #d0b16b;border-radius:8px;background:#fffdf7;">Aucun pouvoir ni sort configuré.</p>{{/if}}

      {{#unless isArcaneDocument}}{{#unless (eq (lowercase system.sousType) "potion")}}<div class="add2e-magic-native-drop-zone" tabindex="0" ondragenter="event.preventDefault();this.classList.add('is-dragover');" ondragover="event.preventDefault();event.stopPropagation();if(event.dataTransfer)event.dataTransfer.dropEffect='copy';this.classList.add('is-dragover');" ondragleave="this.classList.remove('is-dragover');" ondrop="event.preventDefault();event.stopPropagation();this.classList.remove('is-dragover');(async()=>{const item=await fromUuid(this.closest('form').dataset.itemUuid).catch(()=>null);if(!item)return;let data=null;const editor=foundry?.applications?.ux?.TextEditor?.implementation??globalThis.TextEditor;try{data=editor?.getDragEventData?.(event)??null;}catch(_e){}if(!data){try{data=JSON.parse(event.dataTransfer?.getData('text/plain')||'null');}catch(_e){}}let spell=null;if(data?.uuid)spell=await fromUuid(data.uuid).catch(()=>null);if(!spell&&CONFIG?.Item?.documentClass?.fromDropData)spell=await CONFIG.Item.documentClass.fromDropData(data).catch(()=>null);if(!spell){ui.notifications.warn('Le sort déposé est introuvable.');return;}if(await globalThis.add2eStoreSpellInMagicItem?.(item,spell))item.sheet?.render?.({force:true});})().catch(error=>{console.error('[ADD2E][OBJET_MAGIQUE][DROP_ERROR]',error);ui.notifications.error(error?.message||'Erreur pendant l’ajout du sort.');});"><div><i class="fas fa-wand-magic-sparkles" style="font-size:1.5rem;"></i><p style="margin:6px 0 0;"><b>Déposez un sort ici</b></p><p style="margin:3px 0 0;">Le coût en charges sera demandé avant l’ajout.</p></div></div>{{/unless}}{{/unless}}

      {{#if (eq (lowercase system.sousType) "potion")}}<fieldset class="add2e-potion-spell-manager" data-item-uuid="{{item.uuid}}" style="margin-top:12px;border:1px solid #d0b16b;border-radius:7px;padding:10px;"><legend>Contenu de la potion</legend><div class="add2e-potion-spell-drop-zone" tabindex="0"><div><i class="fas fa-flask" style="font-size:1.5rem;"></i><p style="margin:6px 0 0;"><b>Déposez ici le sort à placer dans la potion</b></p><p style="margin:3px 0 0;">Le sort remplacera le contenu actuel après confirmation du MJ.</p></div></div></fieldset>{{/if}}
    </div>

    <div class="content hidden" data-tab="effets"><fieldset style="border:1px solid #d0b16b;border-radius:6px;"><legend>Tags</legend><textarea name="system.tags" rows="4" style="width:100%;">{{#each tags}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</textarea></fieldset><fieldset style="margin-top:10px;border:1px solid #d0b16b;border-radius:6px;"><legend>Effect tags</legend><textarea name="system.effectTags" rows="4" style="width:100%;">{{#each effectTags}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</textarea></fieldset></div>
    <div class="content hidden" data-tab="description"><label><strong>Description</strong></label><div class="add2e-objet-rich-editor">{{editor system.description target="system.description" button=true editable=editable engine="prosemirror"}}</div></div>
  </section>
</form>
