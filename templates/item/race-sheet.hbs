<form class="{{cssClass}} add2e-item-v2-sheet add2e-race-sheet" autocomplete="off">
<style>
.add2e-race-sheet{height:100%;display:flex;flex-direction:column;overflow:hidden;background:#f4e8c9;color:#2f241c}.add2e-race-sheet *{box-sizing:border-box}.add2e-race-sheet .sheet-header{display:flex;gap:12px;padding:10px;background:#fff8e4;border-bottom:1px solid #d0b16b}.add2e-race-sheet .profile-img{width:90px;height:90px;object-fit:cover;border:1px solid #7a5a28;border-radius:50%;cursor:pointer}.add2e-race-sheet .header-fields{flex:1;min-width:0}.add2e-race-sheet h1{margin:0 0 8px}.add2e-race-sheet input,.add2e-race-sheet textarea{width:100%;padding:5px 7px;border:1px solid #b9a15d;border-radius:5px;background:#fffdf6;color:#1d1606}.add2e-race-sheet input[readonly]{background:#f3ead1;color:#5f512e}.add2e-race-sheet label span{display:block;font-size:.76rem;font-weight:800;color:#6f4b12;text-transform:uppercase}.add2e-race-sheet .grid-2,.add2e-race-sheet .grid-3{display:grid;gap:8px}.add2e-race-sheet .grid-2{grid-template-columns:repeat(2,minmax(0,1fr))}.add2e-race-sheet .grid-3{grid-template-columns:repeat(3,minmax(0,1fr))}.add2e-race-sheet .sheet-tabs{display:flex;gap:4px;padding:8px 10px 0;overflow-x:auto;background:#fff8e4;border-bottom:1px solid #d0b16b}.add2e-race-sheet .sheet-tabs .item{padding:7px 12px;border:1px solid #d0b16b;border-bottom:0;border-radius:7px 7px 0 0;background:#fffdf4;color:#6f4b12;font-weight:900;text-decoration:none;white-space:nowrap;cursor:pointer}.add2e-race-sheet .sheet-tabs .item.active{background:#2f6f55;color:#fff}.add2e-race-sheet .sheet-body{flex:1;overflow:auto;padding:12px}.add2e-race-sheet .content.hidden{display:none!important}.add2e-race-sheet fieldset{margin:0 0 12px;padding:10px;border:1px solid #d0b16b;border-radius:8px;background:#fffdf7}.add2e-race-sheet legend{padding:0 6px;font-weight:900;color:#6f4b12}.add2e-race-sheet .row{display:grid;grid-template-columns:180px minmax(0,1fr);gap:8px;align-items:center;padding:6px 0;border-bottom:1px dashed #dccb93}.add2e-race-sheet .row:last-child{border-bottom:0}.add2e-race-sheet .value{font-weight:900;color:#1f6d4e}.add2e-race-sheet .tags{display:flex;gap:5px;flex-wrap:wrap}.add2e-race-sheet .tag{padding:3px 7px;border:1px solid #d8c07d;border-radius:999px;background:#fff7da;font-size:.82em;font-weight:800}.add2e-race-sheet .card{margin:0 0 7px;padding:8px;border:1px solid #e1cf93;border-radius:7px;background:#fffaf0}.add2e-race-sheet .card h3{margin:0 0 4px;color:#2f6f55;font-size:.95em}.add2e-race-sheet .card p{margin:0;white-space:pre-wrap}.add2e-race-sheet .empty,.add2e-race-sheet .note{color:#7f704d;font-style:italic}
</style>
<header class="sheet-header"><img class="profile-img" src="{{img}}" alt="Icône {{item.name}}" data-edit="img"/><div class="header-fields"><h1><input type="text" name="name" value="{{item.name}}"/></h1><div class="grid-3"><label><span>Type</span><input value="{{item.type}}" disabled/></label><label><span>Mouvement</span><input name="system.movement" value="{{system.movement}}"/></label><label><span>Taille</span><input name="system.taille" value="{{system.taille}}"/></label></div><label><span>Description courte</span><textarea name="system.description" rows="2">{{system.description}}</textarea></label></div></header>
<nav class="tabs sheet-tabs" data-group="primary"><a class="item active" data-tab="resume">Résumé</a><a class="item" data-tab="caracs">Caractéristiques</a><a class="item" data-tab="voleur">Voleur</a><a class="item" data-tab="classes">Multiclasse</a><a class="item" data-tab="racial">Profil racial</a><a class="item" data-tab="capacites">Capacités</a><a class="item" data-tab="technique">Technique</a><a class="item" data-tab="description">Description</a></nav>
<section class="sheet-body">
<div class="content active" data-tab="resume"><fieldset><legend>Informations générales</legend><div class="grid-2"><label><span>Langues</span><textarea name="system.langues" rows="4">{{system.langues}}</textarea></label><div><label><span>Slug</span><input name="system.slug" value="{{system.slug}}"/></label><label><span>Âge de départ</span><input name="system.âge_debut" value="{{system.âge_debut}}"/></label><label><span>Espérance de vie</span><input name="system.espérance_vie" value="{{system.espérance_vie}}"/></label></div></div></fieldset><fieldset><legend>Tags</legend><div class="tags">{{#each system.tags}}<span class="tag">{{this}}</span>{{else}}<span class="empty">Aucun tag.</span>{{/each}}</div><div class="tags">{{#each system.identityTags}}<span class="tag">{{this}}</span>{{/each}}</div></fieldset></div>
<div class="content hidden" data-tab="caracs"><fieldset><legend>Bonus et malus de caractéristiques</legend><div class="grid-2">{{#each system.bonus_caracteristiques}}<label><span>{{@key}}</span><input type="number" name="system.bonus_caracteristiques.{{@key}}" value="{{this}}"/></label>{{/each}}</div></fieldset><fieldset><legend>Minimum et maximum</legend>{{#each system.min_caracteristiques}}<div class="row"><strong>{{@key}}</strong><span><input type="number" name="system.min_caracteristiques.{{@key}}" value="{{this}}"/><input type="number" name="system.max_caracteristiques.{{@key}}" value="{{lookup ../system.max_caracteristiques @key}}"/></span></div>{{else}}<p class="empty">Aucune limite.</p>{{/each}}</fieldset></div>
<div class="content hidden" data-tab="voleur"><fieldset><legend>Ajustements raciaux des compétences de voleur</legend><p class="note">Lecture directe de <code>system.thief_adjustments</code>, sans conversion ni recalcul.</p>{{#each system.thief_adjustments}}<div class="row"><strong>{{@key}}</strong><span class="value">{{this}} %</span></div>{{else}}<p class="empty">Cette race ne possède aucun ajustement de voleur.</p>{{/each}}</fieldset></div>
<div class="content hidden" data-tab="classes"><fieldset><legend>Combinaisons autorisées</legend>{{#each system.multiclassing.allowedCombinations}}<div class="row"><strong>{{@key}}</strong><span class="value">{{this}}</span></div>{{else}}<p class="empty">Aucune combinaison définie.</p>{{/each}}</fieldset><fieldset><legend>Limites de classes</legend>{{#each system.limites_classes}}<div class="row"><strong>{{@key}}</strong><input name="system.limites_classes.{{@key}}" value="{{this}}"/></div>{{else}}<p class="empty">Aucune limite définie.</p>{{/each}}</fieldset></div>
<div class="content hidden" data-tab="racial"><fieldset><legend>Identité et vision</legend><div class="row"><strong>Identifiant</strong><input readonly value="{{system.racialProfile.id}}"/></div><div class="row"><strong>Version</strong><input readonly value="{{system.racialProfile.version}}"/></div><div class="row"><strong>Vision</strong><input readonly value="{{system.racialProfile.vision.type}}"/></div><div class="row"><strong>Portée</strong><input readonly value="{{system.racialProfile.vision.range}}"/></div></fieldset><fieldset><legend>Résistances</legend>{{#each system.racialProfile.resistances}}<div class="card"><h3>{{this.types}}</h3><p>{{this.percent}} %</p></div>{{else}}<p class="empty">Aucune résistance.</p>{{/each}}</fieldset><fieldset><legend>Modificateurs d’attaque et de défense</legend>{{#each system.racialProfile.attackModifiers}}<div class="card"><h3>{{this.mode}} — {{this.value}}</h3><p>Armes : {{this.weapons}}<br>Cibles : {{this.targets}}</p></div>{{else}}<p class="empty">Aucun modificateur.</p>{{/each}}</fieldset><fieldset><legend>Bonus de sauvegarde</legend>{{#each system.racialProfile.saveBonuses}}<div class="card"><h3>{{this.mode}}</h3><p>Catégories : {{this.categories}}</p></div>{{else}}<p class="empty">Aucun bonus.</p>{{/each}}</fieldset><fieldset><legend>Immunités</legend><div class="tags">{{#each system.racialProfile.immunities}}<span class="tag">{{this}}</span>{{else}}<span class="empty">Aucune immunité.</span>{{/each}}</div></fieldset><fieldset><legend>Effets passifs</legend>{{#each system.racialProfile.passives}}<div class="card"><h3>{{this.label}}</h3><p><strong>{{this.id}}</strong><br>{{this.description}}</p></div>{{else}}<p class="empty">Aucun effet passif.</p>{{/each}}</fieldset></div>
<div class="content hidden" data-tab="capacites"><fieldset><legend>Capacités raciales générales</legend>{{#each system.capacites}}<p><input name="system.capacites.{{@index}}" value="{{this}}"/></p>{{else}}<p class="empty">Aucune capacité.</p>{{/each}}<p><input name="system.capacites.NEW" value="" placeholder="+ Ajouter une capacité"/></p></fieldset><fieldset><legend>Capacités du profil racial</legend>{{#each system.racialProfile.capabilities}}<div class="card"><h3>{{this.label}}</h3><p><strong>{{this.id}}</strong><br>Formule : {{this.formula}} — réussite : {{this.successAt}}<br>Conditions : {{this.requires}}<br>{{this.description}}</p></div>{{else}}<p class="empty">Aucune capacité de profil.</p>{{/each}}</fieldset></div>
<div class="content hidden" data-tab="technique"><fieldset><legend>Données techniques réellement portées par l’Item</legend><p class="note">Ces champs permettent de vérifier l’import de la race ouverte.</p><div class="row"><strong>Label</strong><input readonly value="{{system.label}}"/></div><div class="row"><strong>Slug</strong><input readonly value="{{system.slug}}"/></div><div class="row"><strong>Mouvement</strong><input readonly value="{{system.movement}}"/></div><div class="row"><strong>OnUse</strong><input readonly value="{{system.onUse}}"/></div><div class="row"><strong>Effect tags</strong><input readonly value="{{system.effectTags}}"/></div></fieldset><fieldset><legend>Effect tags</legend><div class="tags">{{#each system.effectTags}}<span class="tag">{{this}}</span>{{else}}<span class="empty">Aucun effect tag.</span>{{/each}}</div></fieldset></div>
<div class="content hidden" data-tab="description"><fieldset><legend>Description détaillée</legend><textarea name="system.description_longue" rows="10">{{system.description_longue}}</textarea></fieldset><fieldset><legend>Notes MJ et références</legend><textarea name="system.note_md" rows="8">{{system.note_md}}</textarea></fieldset></div>
</section>
</form>
