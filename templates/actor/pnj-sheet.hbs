<div class="sheet actor add2e personnage add2e-character-v3 add2e-pnj-sheet" data-actor-id="{{actor._id}}">
  <style>
    /* Le PNJ emploie les mêmes composants visuels que le PJ. */
    .add2e-pnj-sheet .a2e-summary-kicker{font-size:0}.add2e-pnj-sheet .a2e-summary-kicker::after{content:"PNJ";font-size:var(--font-size-12,12px)}
    .add2e-pnj-sheet .a2e-summary-player label{font-size:0}.add2e-pnj-sheet .a2e-summary-player label::after{content:"Race";font-size:var(--font-size-12,12px)}
    .add2e-pnj-sheet .a2e-progression-overview-race,.add2e-pnj-sheet .a2e-progression-row:nth-child(2),.add2e-pnj-sheet .a2e-tabs .item[data-tab="capacites"],.add2e-pnj-sheet .a2e-tabs .item[data-tab="effets"],.add2e-pnj-sheet .roll-caracs-btn{display:none!important}
    .add2e-pnj-sheet input[name="system.nom_joueur"],.add2e-pnj-sheet input[name="system.race"]{pointer-events:none;background:transparent!important;border-color:transparent!important;color:inherit!important;font-weight:700}
    .add2e-pnj-sheet .a2e-pnj-class-actions{display:flex;align-items:center;gap:7px}.add2e-pnj-sheet .a2e-pnj-class-row{display:grid;grid-template-columns:32px minmax(0,1fr) 62px minmax(100px,1fr) 30px;gap:7px;align-items:center}.add2e-pnj-sheet .a2e-pnj-class-row img{width:28px;height:28px;object-fit:cover;border-radius:4px}.add2e-pnj-sheet .a2e-pnj-class-row input{width:58px;text-align:center}.add2e-pnj-sheet .a2e-pnj-memory{display:inline-flex;align-items:center;gap:7px}.add2e-pnj-sheet .a2e-pnj-spell-level{margin:10px 0 4px;padding:5px 8px;border-radius:5px;background:linear-gradient(90deg,#67418f,#9678ba);color:#fff;font-weight:900}.add2e-pnj-sheet .a2e-pnj-note{width:100%;min-height:260px;resize:vertical}.add2e-pnj-sheet .a2e-pnj-item-name{display:flex;align-items:center;gap:7px}.add2e-pnj-sheet .a2e-pnj-item-name img{width:30px;height:30px;object-fit:cover;border-radius:5px}.add2e-pnj-sheet .a2e-pnj-muted{color:#766643;font-style:italic}.add2e-pnj-sheet .a2e-actions{white-space:nowrap}.add2e-pnj-sheet .a2e-action-icon{cursor:pointer}
    @media(max-width:760px){.add2e-pnj-sheet .a2e-pnj-class-row{grid-template-columns:30px minmax(0,1fr) 56px 28px}.add2e-pnj-sheet .a2e-pnj-class-title{display:none}}
  </style>

  <input type="hidden" class="a2e-active-tab-input" value="{{activeTab}}">
  <div class="a2e-shell">
    {{> "systems/add2e/templates/actor/parts/character-header.hbs"}}
    {{> "systems/add2e/templates/actor/parts/character-caracs-saves.hbs"}}
    {{> "systems/add2e/templates/actor/parts/character-tabs.hbs"}}

    <main class="sheet-body">
      <section class="a2e-tab-content tab tab-resume {{#if (eq activeTab "resume")}}active{{/if}}" data-group="primary" data-tab="resume">
        <div class="a2e-grid-2">
          <div class="a2e-panel">
            <h2>Identité</h2>
            <div class="a2e-panel-body">
              <table class="a2e-table"><tbody>
                <tr><th>Race</th><td>{{raceName}}</td></tr>
                <tr><th>Langues</th><td><input type="text" name="system.langues" value="{{system.langues}}"></td></tr>
                <tr><th>Vision</th><td><input type="text" name="system.vision" value="{{system.vision}}"></td></tr>
                <tr><th>Alignement</th><td>{{system.alignement}}</td></tr>
              </tbody></table>
            </div>
          </div>
          <div class="a2e-panel">
            <h2>Classes</h2>
            <div class="a2e-panel-body">
              {{#if classes.length}}
                <table class="a2e-table"><thead><tr><th></th><th>Classe</th><th>Niveau</th><th>Titre</th><th></th></tr></thead><tbody>
                  {{#each classes}}
                    <tr data-item-id="{{id}}"><td><img src="{{img}}" style="width:28px;height:28px;border-radius:4px;object-fit:cover"></td><td><b>{{name}}</b></td><td>{{level}}</td><td>{{#if title}}{{title}}{{else}}—{{/if}}</td><td><a class="a2e-action-icon a2e-action-delete" data-action="delete-class" data-item-id="{{id}}" title="Retirer cette classe"><i class="fas fa-trash"></i></a></td></tr>
                  {{/each}}
                </tbody></table>
              {{else}}<p class="a2e-pnj-muted">Dépose une classe sur la feuille.</p>{{/if}}
              <p class="a2e-small">Race et classes sont libres : aucune vérification de compatibilité, de prérequis ou de niveau racial n’est appliquée au PNJ.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="a2e-tab-content tab tab-combat {{#if (eq activeTab "combat")}}active{{/if}}" data-group="primary" data-tab="combat">
        <div class="a2e-grid-2">
          <div class="a2e-panel"><h2>Défense</h2><div class="a2e-panel-body"><table class="a2e-table"><tbody>
            <tr><th>CA naturelle / physique</th><td>{{combatDefense.natural}}</td></tr>
            <tr><th>CA totale</th><td><b>{{combatDefense.total}}</b></td></tr>
            <tr><th>Mod. DEX défense</th><td>{{combatDefense.dexDefense}}</td></tr>
          </tbody></table></div></div>
          <div class="a2e-panel"><h2>Règles PNJ</h2><div class="a2e-panel-body"><p class="a2e-muted">Les armes à distance du PNJ ne consomment pas de projectiles. Ses sorts ne demandent pas de composants matériels.</p></div></div>
        </div>

        <div class="a2e-panel"><h2>Armes</h2><div class="a2e-panel-body">
          {{#if weapons.length}}<table class="a2e-table arme-table"><thead><tr><th></th><th>Arme</th><th>Équipée</th><th>Actions</th></tr></thead><tbody>
            {{#each weapons}}<tr class="item" data-item-id="{{id}}"><td><img class="arme-img-attack" data-action="attack" data-item-id="{{id}}" src="{{img}}" title="Attaquer avec {{name}}"></td><td><b>{{name}}</b></td><td>{{#if equipped}}<i class="fas fa-check-circle equip-green"></i>{{else}}<i class="fas fa-times-circle equip-red"></i>{{/if}}</td><td><div class="a2e-actions"><a class="a2e-action-icon a2e-equip-state-icon {{#if equipped}}equip-green{{else}}equip-red{{/if}}" data-action="equip-item" data-item-id="{{id}}" title="Équiper"><i class="fas fa-swords"></i></a><a class="a2e-action-icon a2e-action-edit" data-action="open-item" data-item-id="{{id}}" title="Éditer"><i class="fas fa-edit"></i></a><a class="a2e-action-icon a2e-action-delete" data-action="delete-item" data-item-id="{{id}}" title="Supprimer"><i class="fas fa-trash"></i></a></div></td></tr>{{/each}}
          </tbody></table>{{else}}<p class="a2e-pnj-muted">Aucune arme.</p>{{/if}}
        </div></div>

        <div class="a2e-panel"><h2>Armures, boucliers et heaumes</h2><div class="a2e-panel-body">
          {{#if armors.length}}<table class="a2e-table"><thead><tr><th>Nom</th><th>CA</th><th>Équipée</th><th>Actions</th></tr></thead><tbody>
            {{#each armors}}<tr class="item" data-item-id="{{id}}"><td><div class="a2e-pnj-item-name"><img src="{{img}}"><b>{{name}}</b></div></td><td>{{ac}}</td><td>{{#if equipped}}<i class="fas fa-check-circle equip-green"></i>{{else}}<i class="fas fa-times-circle equip-red"></i>{{/if}}</td><td><div class="a2e-actions"><a class="a2e-action-icon a2e-equip-state-icon {{#if equipped}}equip-green{{else}}equip-red{{/if}}" data-action="equip-item" data-item-id="{{id}}"><i class="fas fa-shield-alt"></i></a><a class="a2e-action-icon a2e-action-edit" data-action="open-item" data-item-id="{{id}}"><i class="fas fa-edit"></i></a><a class="a2e-action-icon a2e-action-delete" data-action="delete-item" data-item-id="{{id}}"><i class="fas fa-trash"></i></a></div></td></tr>{{/each}}
          </tbody></table>{{else}}<p class="a2e-pnj-muted">Aucune armure.</p>{{/if}}
        </div></div>
      </section>

      <section class="a2e-tab-content tab tab-sorts {{#if (eq activeTab "sorts")}}active{{/if}}" data-group="primary" data-tab="sorts">
        <div class="a2e-panel"><h2>Sorts</h2><div class="a2e-panel-body"><p class="a2e-small">Les sorts du PNJ n’utilisent ni sacoche ni composants matériels.</p>
          {{#each spellLevels}}<div class="a2e-pnj-spell-level">Niveau {{level}}</div><table class="a2e-table"><thead><tr><th>Sort</th><th>Mémorisé</th><th>Actions</th></tr></thead><tbody>
            {{#each spells}}<tr class="item" data-item-id="{{id}}"><td><div class="a2e-pnj-item-name"><img src="{{img}}"><b>{{name}}</b></div></td><td><span class="a2e-pnj-memory"><a class="a2e-action-icon" data-action="spell-memory" data-delta="-1" data-item-id="{{id}}"><i class="fas fa-minus"></i></a><b>{{memorized}}</b><a class="a2e-action-icon" data-action="spell-memory" data-delta="1" data-item-id="{{id}}"><i class="fas fa-plus"></i></a></span></td><td><div class="a2e-actions"><a class="a2e-action-icon" data-action="cast-spell" data-item-id="{{id}}" title="Lancer"><i class="fas fa-wand-magic-sparkles"></i></a><a class="a2e-action-icon a2e-action-edit" data-action="open-item" data-item-id="{{id}}"><i class="fas fa-edit"></i></a><a class="a2e-action-icon a2e-action-delete" data-action="delete-item" data-item-id="{{id}}"><i class="fas fa-trash"></i></a></div></td></tr>{{/each}}
          </tbody></table>{{else}}<p class="a2e-pnj-muted">Aucun sort.</p>{{/each}}
        </div></div>
      </section>

      <section class="a2e-tab-content tab tab-equipement {{#if (eq activeTab "equipement")}}active{{/if}}" data-group="primary" data-tab="equipement">
        <div class="a2e-panel"><h2>Équipement et objets</h2><div class="a2e-panel-body">
          {{#if gear.length}}<table class="a2e-table"><thead><tr><th>Objet</th><th>Quantité</th><th>Équipé</th><th>Actions</th></tr></thead><tbody>
            {{#each gear}}<tr class="item" data-item-id="{{id}}"><td><div class="a2e-pnj-item-name"><img src="{{img}}"><b>{{name}}</b></div></td><td>{{quantity}}</td><td>{{#if equipped}}<i class="fas fa-check-circle equip-green"></i>{{else}}<i class="fas fa-times-circle equip-red"></i>{{/if}}</td><td><div class="a2e-actions"><a class="a2e-action-icon a2e-equip-state-icon {{#if equipped}}equip-green{{else}}equip-red{{/if}}" data-action="equip-item" data-item-id="{{id}}"><i class="fas fa-shield-alt"></i></a><a class="a2e-action-icon a2e-action-edit" data-action="open-item" data-item-id="{{id}}"><i class="fas fa-edit"></i></a><a class="a2e-action-icon a2e-action-delete" data-action="delete-item" data-item-id="{{id}}"><i class="fas fa-trash"></i></a></div></td></tr>{{/each}}
          </tbody></table>{{else}}<p class="a2e-pnj-muted">Aucun équipement.</p>{{/if}}
        </div></div>
      </section>

      <section class="a2e-tab-content tab tab-notes {{#if (eq activeTab "notes")}}active{{/if}}" data-group="primary" data-tab="notes">
        <div class="a2e-panel"><h2>Notes</h2><div class="a2e-panel-body"><textarea class="a2e-pnj-note" name="system.notes">{{system.notes}}</textarea></div></div>
      </section>
    </main>
  </div>
</div>
