<div class="sheet actor add2e personnage add2e-character-v3 add2e-pnj-sheet" data-actor-id="{{actor._id}}">
  <style>
    /* Structure PJ conservée ; palette bleu pétrole réservée aux PNJ. */
    .add2e-pnj-sheet{--a2e-bg:#163e52;--a2e-panel:rgba(227,240,245,.98);--a2e-panel-soft:rgba(202,224,234,.98);--a2e-border:#27637c;--a2e-gold:#2e7895;--a2e-gold-dark:#123a4f;--a2e-text:#102f40;--a2e-muted:#446a7b}
    .add2e-pnj-sheet .a2e-shell{background:radial-gradient(circle at top left,rgba(139,210,231,.25),transparent 30%),linear-gradient(135deg,#174e67 0%,#0d3044 58%,#09283a 100%)!important;border:1px solid #55a7c5!important;box-shadow:inset 0 1px 0 rgba(205,244,255,.34),0 5px 16px rgba(4,22,31,.48)!important}
    .add2e-pnj-sheet .a2e-summary-header{background:radial-gradient(circle at 0 0,rgba(176,234,248,.34),transparent 31%),linear-gradient(135deg,rgba(32,103,132,.98),rgba(13,55,76,.98))!important;border-color:#55a7c5!important;box-shadow:0 3px 11px rgba(4,22,31,.38)!important}
    .add2e-pnj-sheet .a2e-summary-identity .a2e-summary-kicker,.add2e-pnj-sheet .a2e-summary-identity .a2e-name{color:#eefaff!important}
    .add2e-pnj-sheet .a2e-summary-identity .a2e-name{border-bottom-color:#ffcf57!important}
    .add2e-pnj-sheet .a2e-progression-overview-race input[readonly]{color:#175d4b!important;opacity:1!important}
    .add2e-pnj-sheet .a2e-panel{background:rgba(227,240,245,.98)!important;border-color:#5b9bb5!important;box-shadow:0 1px 4px rgba(5,32,45,.24)!important}
    .add2e-pnj-sheet .a2e-panel h2{color:#0f455d!important;border-color:#65a9c4!important}
    .add2e-pnj-sheet .a2e-tabs{border-color:#4c96b3!important;background:rgba(9,42,59,.74)!important}
    .add2e-pnj-sheet .a2e-tabs .item{color:#d8f1fa!important;border-color:rgba(112,190,219,.48)!important}
    .add2e-pnj-sheet .a2e-tabs .item.active{background:linear-gradient(180deg,#63bdd7,#2a7898)!important;border-color:#9de4f4!important;color:#082b3b!important;text-shadow:none!important}
    .add2e-pnj-sheet .a2e-summary-kicker{font-size:0}.add2e-pnj-sheet .a2e-summary-kicker::after{content:"PNJ";font-size:var(--font-size-12,12px)}
    .add2e-pnj-sheet .a2e-summary-player{display:none!important}
    .add2e-pnj-sheet .a2e-progression-row:nth-child(2),.add2e-pnj-sheet .a2e-tabs .item[data-tab="capacites"],.add2e-pnj-sheet .roll-caracs-btn{display:none!important}
    .add2e-pnj-sheet .add2e-components-pouch-panel{display:none!important}
    .add2e-pnj-sheet .a2e-spell-list-group .sort-table th:nth-child(6),.add2e-pnj-sheet .a2e-spell-list-group .sort-table td:nth-child(6){display:none!important}
    .add2e-pnj-sheet [data-action="trade-item"],.add2e-pnj-sheet [data-action="trade-money"],.add2e-pnj-sheet .objet-create{display:none!important}
  </style>

  <input type="hidden" class="a2e-active-tab-input" name="flags.add2e.activeSheetTab" value="{{activeTab}}">
  <div class="a2e-shell">
    {{> "systems/add2e/templates/actor/parts/character-header.hbs"}}
    {{> "systems/add2e/templates/actor/parts/character-caracs-saves.hbs"}}
    {{> "systems/add2e/templates/actor/parts/character-tabs.hbs"}}

    <main class="sheet-body">
      {{> "systems/add2e/templates/actor/parts/tab-resume.hbs"}}
      {{> "systems/add2e/templates/actor/parts/tab-combat.hbs"}}
      {{> "systems/add2e/templates/actor/parts/tab-sorts.hbs"}}
      {{> "systems/add2e/templates/actor/parts/tab-effets.hbs"}}
      {{> "systems/add2e/templates/actor/parts/tab-equipement.hbs"}}
      {{> "systems/add2e/templates/actor/parts/tab-notes.hbs"}}
    </main>
  </div>
</div>
