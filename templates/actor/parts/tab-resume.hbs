      <section class='a2e-tab-content tab tab-resume {{#if (eq activeTab "resume")}}active{{/if}}' data-group="primary" data-tab="resume">
        <div class="a2e-summary-dashboard">
          <div>
            <div class="a2e-summary-metrics">
              <div class="a2e-summary-card">
                <i class="fas fa-shield-alt"></i>
                <div>
                  <label>CA</label>
                  <strong>{{combatDefense.ac_totale}}</strong>
                  <small>base résolue {{combatDefense.ac_base}}</small>
                </div>
              </div>

              <div class="a2e-summary-card">
                <i class="fas fa-crosshairs"></i>
                <div>
                  <label>THAC0</label>
                  <strong>{{combatDefense.thaco}}</strong>
                  <small>meilleure progression active</small>
                </div>
              </div>

              <div class="a2e-summary-card">
                <i class="fas fa-running"></i>
                <div>
                  <label>Mouvement</label>
                  <strong>{{movement.actuel}} m</strong>
                  <small>{{movement.display.categoryLabel}}</small>
                </div>
              </div>
            </div>

            <div class="a2e-panel a2e-movement-summary">
              <h2><i class="fas fa-person-walking-luggage"></i> Mouvement et encombrement</h2>
              <div class="a2e-panel-body">
                <div class="a2e-summary-pills" style="margin-bottom:8px;">
                  <span class="a2e-summary-pill" title="Source du mouvement naturel">
                    <b>Source</b>&nbsp;{{movement.display.sourceLabel}}
                  </span>
                  <span class="a2e-summary-pill" title="Mouvement naturel avant armure, charge et effets">
                    <b>Base</b>&nbsp;{{movement.display.naturalMovement}} m
                  </span>
                  <span class="a2e-summary-pill" title="Mouvement final résolu">
                    <b>Final</b>&nbsp;{{movement.display.finalMovement}} m
                  </span>
                  <span class="a2e-summary-pill" title="Poids canonique : {{movement.display.weightPo}} unités d’encombrement">
                    <b>Charge</b>&nbsp;{{movement.display.weightLabel}}
                  </span>
                  <span class="a2e-summary-pill">
                    <b>Force</b>&nbsp;{{movement.display.strengthTableKey}}
                  </span>
                  <span class="a2e-summary-pill">
                    <b>État</b>&nbsp;{{movement.display.categoryLabel}}
                  </span>
                  <span class="a2e-summary-pill" title="Multiplicateur appliqué au mouvement naturel">
                    <b>Multiplicateur</b>&nbsp;×{{movement.display.multiplier}}
                  </span>
                  <span class="a2e-summary-pill" title="Pénalité appliquée aux jets d’attaque">
                    <b>Attaque</b>&nbsp;{{movement.display.attackPenaltyDisplay}}
                  </span>
                  <span class="a2e-summary-pill" title="Ajustement appliqué à la classe d’armure">
                    <b>CA</b>&nbsp;{{movement.display.armorClassPenaltyDisplay}}
                  </span>
                  {{#if movement.display.hasArmorLimit}}
                    <span class="a2e-summary-pill" title="Plafond de mouvement imposé par l’armure équipée">
                      <b>Armure</b>&nbsp;{{movement.display.armorLabel}}
                    </span>
                  {{/if}}
                  {{#if movement.display.hasSizeFactor}}
                    <span class="a2e-summary-pill" title="{{movement.display.sizeFactorSource}}">
                      <b>Facteur de taille</b>&nbsp;×{{movement.display.sizeFactor}}
                    </span>
                  {{/if}}
                  {{#if movement.display.encumbranceIgnored}}
                    <span class="a2e-summary-pill" title="{{movement.display.ignoredByLabel}}">
                      <i class="fas fa-feather"></i>&nbsp;<b>Déplacement sans pénalité de charge</b>
                    </span>
                  {{/if}}
                </div>

                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(128px,1fr));gap:6px;">
                  {{#each movement.display.capacityRows as |row|}}
                    <div style="padding:7px 8px;border:1px solid {{#if row.active}}#2f6f55{{else}}rgba(90,72,35,.25){{/if}};border-radius:7px;background:{{#if row.active}}rgba(47,111,85,.12){{else}}rgba(255,255,255,.35){{/if}};">
                      <div style="font-size:.76rem;font-weight:900;text-transform:uppercase;letter-spacing:.03em;">{{row.label}}</div>
                      <div style="margin-top:2px;font-weight:800;">
                        {{#if row.limitKg}}jusqu’à {{row.limitKg}} kg{{else}}au-delà de la limite{{/if}}
                      </div>
                    </div>
                  {{/each}}
                </div>
              </div>
            </div>

            <div class="a2e-panel">
              <h2><i class="fas fa-swords"></i> Attaque rapide</h2>
              <div class="a2e-panel-body">
                {{#if equippedWeaponRows.length}}
                  <div class="a2e-summary-attack-list">
                    {{#each equippedWeaponRows as |row|}}
                      <div class="a2e-summary-weapon item" data-item-id="{{row.id}}" title="Toucher : {{row.attackDetailsTitle}}&#10;Dégâts : {{row.damageDetailsTitle}}">
                        <img class="arme-img-attack" data-item-id="{{row.id}}" src="{{row.img}}" title="Attaquer avec {{row.name}}">
                        <div>
                          <div class="a2e-summary-weapon-name">{{row.name}}</div>
                          <div class="a2e-summary-weapon-meta">
                            <span><b>Dégâts</b> {{row.damage}}</span>
                            <span><b>Type</b> {{row.type}}</span>
                            <span><b>Toucher</b> {{row.totalHitSigned}}</span>
                            <span><b>Dégâts bonus</b> {{row.totalDamageSigned}}</span>
                            {{#if row.projectileName}}<span><b>Projectile</b> {{row.projectileName}} ×{{row.projectileQuantity}}</span>{{/if}}
                            {{#if row.projectileMissing}}<span><b>Projectile</b> manquant</span>{{/if}}
                          </div>
                        </div>
                        <button type="button" class="a2e-summary-attack-button arme-img-attack" data-item-id="{{row.id}}">
                          <i class="fas fa-dice-d20"></i>&nbsp;Attaquer
                        </button>
                      </div>
                    {{/each}}
                  </div>
                {{else}}
                  <p class="a2e-muted">Aucune arme équipée.</p>
                {{/if}}
              </div>
            </div>

            <div class="a2e-grid-2">
              <div class="a2e-panel">
                <h2><i class="fas fa-shield-alt"></i> Défense résolue</h2>
                <div class="a2e-panel-body">
                  <div class="a2e-summary-pills">
                    {{#each combatDefense.summaryRows as |row|}}
                      <span class="a2e-summary-pill" title="{{row.sourceName}}">{{row.label}} : {{row.value}}</span>
                    {{/each}}
                    <span class="a2e-summary-pill"><b>CA finale : {{combatDefense.ac_totale}}</b></span>
                  </div>
                </div>
              </div>

              <div class="a2e-panel">
                <h2><i class="fas fa-magic"></i> Préparations</h2>
                <div class="a2e-panel-body">
                  {{#if add2eSpellSummaryRows.length}}
                    <div class="a2e-summary-pills a2e-prep-summary">
                      {{#each add2eSpellSummaryRows as |row|}}
                        {{#each row.levels as |level|}}
                          <span class="a2e-summary-pill a2e-prep-pill">
                            <b>{{row.label}} N{{level.spellLevel}}</b>
                            <span>{{level.count}} / {{level.max}}</span>
                          </span>
                        {{/each}}
                      {{/each}}
                    </div>
                  {{else}}
                    <p class="a2e-muted">Aucun emplacement de sort.</p>
                  {{/if}}
                </div>
              </div>
            </div>
          </div>

          <div>
            <div class="a2e-panel">
              <h2><i class="fas fa-id-card"></i> Classe / race</h2>
              <div class="a2e-panel-body a2e-small">
                <div class="a2e-summary-pills" style="margin-bottom:8px;">
                  <span class="a2e-summary-pill">{{actor.system.race}}</span>
                  <span class="a2e-summary-pill">{{actor.system.classe}} niv. {{actor.system.niveau}}</span>
                  <span class="a2e-summary-pill">{{actor.system.alignement}}</span>
                </div>

                {{#if actor.system.details_race.capacites.length}}
                  <h3>Race</h3>
                  <ul class="a2e-summary-simple-list">
                    {{#each actor.system.details_race.capacites}}
                      <li>{{this}}</li>
                    {{/each}}
                  </ul>
                {{/if}}

                {{#if summaryClassFeatures.length}}
                  <h3>Capacités de classe</h3>
                  <ul class="a2e-summary-simple-list">
                    {{#each summaryClassFeatures as |feature|}}
                      <li>
                        <b>{{feature.name}}</b>
                        {{#if feature.showClassName}}
                          <small class="a2e-muted"> — {{feature.className}}{{#if feature.classLevel}} niv. {{feature.classLevel}}{{/if}}</small>
                        {{/if}}
                      </li>
                    {{/each}}
                  </ul>
                {{else}}
                  <p class="a2e-muted">Aucune capacité de classe disponible à ce niveau.</p>
                {{/if}}
              </div>
            </div>
          </div>
        </div>
      </section>
