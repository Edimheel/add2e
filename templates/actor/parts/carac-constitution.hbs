            <tr>
              <td class="carac-label-td">
                <div class="carac-flex">
                  <i class="fas fa-dice-d20 roll-stat" data-stat="constitution" title="Jet de Constitution" style="color:#e74c3c;"></i>
                  <span class="carac-short">CON</span>
                </div>
              </td>
              <td>
                <div class="carac-control-group">
                  <button type="button" class="carac-btn moins" data-carac="constitution" tabindex="-1">−</button>
                  <div class="carac-value carac-drop-target" data-carac="constitution"
                       title="Base : {{abilityDerived.constitution.base}}&#10;Valeur finale : {{abilityDerived.constitution.total}}{{#each abilityDerived.constitution.modifiers}}&#10;{{label}} {{value}}{{/each}}">
                    <span style="font-size:1.45em;font-weight:700;line-height:1;">{{abilityDerived.constitution.total}}</span>
                    {{#if abilityDerived.constitution.hasAdjustment}}
                      <span class="carac-racial-bonus-inline">({{abilityDerived.constitution.adjustmentDisplay}})</span>
                    {{/if}}
                  </div>
                  <button type="button" class="carac-btn plus" data-carac="constitution" tabindex="-1">+</button>
                </div>
              </td>
              <td>
                <div class="carac-adjustments-line">
                  <div class="a2e-adjustment-item">
                    <label>PV / niv.</label>
                    <input type="text" value="{{signedNumber abilityDerived.constitution.hitPointBonus.value}}" title="{{abilityDerived.constitution.hitPointBonus.description}}" readonly>
                  </div>
                  <div class="a2e-adjustment-item">
                    <label>Choc</label>
                    <div style="display:flex;align-items:center;gap:3px;">
                      <input type="text" value="{{abilityDerived.constitution.profile.trauma}} %" readonly>
                      <button type="button" class="add2e-constitution-check" data-check="trauma" title="Tester la résistance aux traumatismes" aria-label="Tester la résistance aux traumatismes" style="width:26px;height:24px;min-width:26px;padding:0;display:inline-flex;align-items:center;justify-content:center;">
                        <i class="fas fa-heart-pulse"></i>
                      </button>
                    </div>
                  </div>
                  <div class="a2e-adjustment-item">
                    <label>Résurrection</label>
                    <div style="display:flex;align-items:center;gap:3px;">
                      <input type="text" value="{{abilityDerived.constitution.profile.resu}} %" readonly>
                      <button type="button" class="add2e-constitution-check" data-check="resurrection" title="Tester la survie à la résurrection" aria-label="Tester la survie à la résurrection" style="width:26px;height:24px;min-width:26px;padding:0;display:inline-flex;align-items:center;justify-content:center;">
                        <i class="fas fa-hand-holding-heart"></i>
                      </button>
                    </div>
                  </div>
                </div>
              </td>
            </tr>
