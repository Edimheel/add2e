            <tr>
              <td class="carac-label-td">
                <div class="carac-flex">
                  <i class="fas fa-dice-d20 roll-stat" data-stat="intelligence" title="Jet d’Intelligence" style="color:#2980b9;"></i>
                  <span class="carac-short">INT</span>
                </div>
              </td>
              <td>
                <div class="carac-control-group">
                  <button type="button" class="carac-btn moins" data-carac="intelligence" tabindex="-1">−</button>
                  <div class="carac-value carac-drop-target" data-carac="intelligence"
                       title="Base : {{abilityDerived.intelligence.base}}&#10;Valeur finale : {{abilityDerived.intelligence.total}}&#10;{{abilityDerived.intelligence.boundsDisplay}}{{#each abilityDerived.intelligence.modifiers}}&#10;{{label}} {{value}}{{/each}}">
                    <span style="font-size:1.45em;font-weight:700;line-height:1;">{{abilityDerived.intelligence.total}}</span>
                    {{#if abilityDerived.intelligence.hasAdjustment}}
                      <span class="carac-racial-bonus-inline">({{abilityDerived.intelligence.adjustmentDisplay}})</span>
                    {{/if}}
                  </div>
                  <button type="button" class="carac-btn plus" data-carac="intelligence" tabindex="-1">+</button>
                </div>
              </td>
              <td>
                <div class="carac-adjustments-line">
                  <div class="a2e-adjustment-item"><label>Langues</label><input type="text" value="{{abilityDerived.intelligence.profile.langues}}" readonly></div>
                  <div class="a2e-adjustment-item"><label>% sort</label><input type="text" value="{{abilityDerived.intelligence.profile.chance_sort}} %" readonly></div>
                  <div class="a2e-adjustment-item"><label>Sorts min</label><input type="text" value="{{abilityDerived.intelligence.profile.min_sort}}" readonly></div>
                  <div class="a2e-adjustment-item"><label>Sorts max</label><input type="text" value="{{abilityDerived.intelligence.profile.max_sort}}" readonly></div>
                  <div class="a2e-adjustment-item"><label>/ niveau</label><input type="text" value="{{abilityDerived.intelligence.profile.sort_par_niveau}}" readonly></div>
                  <div class="a2e-adjustment-item"><label>Niv. max</label><input type="text" value="{{abilityDerived.intelligence.profile.niveau_sort_max}}" readonly></div>
                  <div class="a2e-adjustment-item"><label>Illusions</label><input type="text" value="{{abilityDerived.intelligence.illusionImmunitiesSummary}}" readonly></div>
                </div>
              </td>
            </tr>
