            <tr>
              <td class="carac-label-td">
                <div class="carac-flex">
                  <i class="fas fa-dice-d20 roll-stat" data-stat="intelligence" title="Jet d’Intelligence" style="color:#2980b9;"></i>
                  <span class="carac-short">INT</span>
                </div>
              </td>
              <td>
                <div class="carac-control-group">
                  <button type="button" class="carac-btn moins" data-carac="intelligence" tabindex="-1">−</button>
                  <div class="carac-value carac-drop-target" data-carac="intelligence"
                       title="Base : {{abilityDerived.intelligence.base}}&#10;Valeur finale : {{abilityDerived.intelligence.total}}&#10;{{abilityDerived.intelligence.boundsDisplay}}{{#each abilityDerived.intelligence.modifiers}}&#10;{{label}} {{value}}{{/each}}">
                    <span style="font-size:1.45em;font-weight:700;line-height:1;">{{abilityDerived.intelligence.total}}</span>
                    {{#if abilityDerived.intelligence.hasAdjustment}}
                      <span class="carac-racial-bonus-inline">({{abilityDerived.intelligence.adjustmentDisplay}})</span>
                    {{/if}}
                  </div>
                  <button type="button" class="carac-btn plus" data-carac="intelligence" tabindex="-1">+</button>
                </div>
              </td>
              <td>
                <div class="carac-adjustments-line" style="display:grid;grid-template-columns:1fr;gap:8px;width:100%;">
                  <section style="display:grid;gap:4px;min-width:0;">
                    <div style="font-size:0.72em;font-weight:900;line-height:1;color:#6f4b12;text-transform:uppercase;letter-spacing:0.03em;">Connaissances</div>
                    <div style="display:grid;grid-template-columns:repeat(4,minmax(74px,1fr));gap:6px;min-width:0;">
                      <div class="a2e-adjustment-item" style="max-width:none;min-width:0;grid-template-rows:minmax(26px,auto) 30px;">
                        <label style="white-space:normal;overflow:visible;text-overflow:clip;line-height:1.08;min-height:26px;display:flex;align-items:flex-end;justify-content:center;">Langues</label>
                        <input type="text" value="{{abilityDerived.intelligence.profile.langues}}" title="Langues supplémentaires" style="width:100%;min-width:0;height:30px;" readonly>
                      </div>
                      <div class="a2e-adjustment-item" style="max-width:none;min-width:0;grid-template-rows:minmax(26px,auto) 30px;">
                        <label style="white-space:normal;overflow:visible;text-overflow:clip;line-height:1.08;min-height:26px;display:flex;align-items:flex-end;justify-content:center;">Chance d’apprendre</label>
                        <input type="text" value="{{abilityDerived.intelligence.profile.chance_sort}} %" title="Chance de connaître chaque sort" style="width:100%;min-width:0;height:30px;" readonly>
                      </div>
                      <div class="a2e-adjustment-item" style="max-width:none;min-width:0;grid-template-rows:minmax(26px,auto) 30px;">
                        <label style="white-space:normal;overflow:visible;text-overflow:clip;line-height:1.08;min-height:26px;display:flex;align-items:flex-end;justify-content:center;">Niveau maximal</label>
                        <input type="text" value="{{abilityDerived.intelligence.profile.niveau_sort_max}}" title="Niveau maximal de sort accessible" style="width:100%;min-width:0;height:30px;" readonly>
                      </div>
                      <div class="a2e-adjustment-item" style="max-width:none;min-width:0;grid-template-rows:minmax(26px,auto) 30px;">
                        <label style="white-space:normal;overflow:visible;text-overflow:clip;line-height:1.08;min-height:26px;display:flex;align-items:flex-end;justify-content:center;">Immunités aux illusions</label>
                        <input type="text" value="{{abilityDerived.intelligence.illusionImmunitiesSummary}}" title="Niveaux d’illusions auxquels le personnage est immunisé" style="width:100%;min-width:0;height:30px;" readonly>
                      </div>
                    </div>
                  </section>

                  <section style="display:grid;gap:4px;min-width:0;">
                    <div style="font-size:0.72em;font-weight:900;line-height:1;color:#6f4b12;text-transform:uppercase;letter-spacing:0.03em;">Apprentissage des sorts</div>
                    <div style="display:grid;grid-template-columns:repeat(3,minmax(96px,1fr));gap:6px;min-width:0;">
                      <div class="a2e-adjustment-item" style="max-width:none;min-width:0;grid-template-rows:minmax(26px,auto) 30px;">
                        <label style="white-space:normal;overflow:visible;text-overflow:clip;line-height:1.08;min-height:26px;display:flex;align-items:flex-end;justify-content:center;">Minimum par niveau</label>
                        <input type="text" value="{{abilityDerived.intelligence.profile.min_sort}}" title="Nombre minimum de sorts connus par niveau" style="width:100%;min-width:0;height:30px;" readonly>
                      </div>
                      <div class="a2e-adjustment-item" style="max-width:none;min-width:0;grid-template-rows:minmax(26px,auto) 30px;">
                        <label style="white-space:normal;overflow:visible;text-overflow:clip;line-height:1.08;min-height:26px;display:flex;align-items:flex-end;justify-content:center;">Maximum par niveau</label>
                        <input type="text" value="{{abilityDerived.intelligence.profile.max_sort}}" title="Nombre maximum de sorts connus par niveau" style="width:100%;min-width:0;height:30px;" readonly>
                      </div>
                      <div class="a2e-adjustment-item" style="max-width:none;min-width:0;grid-template-rows:minmax(26px,auto) 30px;">
                        <label style="white-space:normal;overflow:visible;text-overflow:clip;line-height:1.08;min-height:26px;display:flex;align-items:flex-end;justify-content:center;">Sorts par niveau</label>
                        <input type="text" value="{{abilityDerived.intelligence.profile.sort_par_niveau}}" title="Capacité de sorts par niveau" style="width:100%;min-width:0;height:30px;" readonly>
                      </div>
                    </div>
                  </section>
                </div>
              </td>
            </tr>
