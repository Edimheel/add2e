            <tr>
              <td class="carac-label-td">
                <div class="carac-flex">
                  <i class="fas fa-dice-d20 roll-stat" data-stat="intelligence" title="Jet d’Intelligence" style="color:#2980b9;"></i>
                  <span class="carac-short">INT</span>
                </div>
              </td>
              <td>
                <div class="carac-control-group">
                  <button type="button" class="carac-btn moins" data-carac="intelligence" tabindex="-1">−</button>
                  <div class="carac-value carac-drop-target" data-carac="intelligence"
                       title="Base : {{abilityDerived.intelligence.base}}&#10;Valeur finale : {{abilityDerived.intelligence.total}}&#10;{{abilityDerived.intelligence.boundsDisplay}}{{#each abilityDerived.intelligence.modifiers}}&#10;{{label}} {{value}}{{/each}}">
                    <span style="font-size:1.45em;font-weight:700;line-height:1;">{{abilityDerived.intelligence.total}}</span>
                    {{#if abilityDerived.intelligence.hasAdjustment}}
                      <span class="carac-racial-bonus-inline">({{abilityDerived.intelligence.adjustmentDisplay}})</span>
                    {{/if}}
                  </div>
                  <button type="button" class="carac-btn plus" data-carac="intelligence" tabindex="-1">+</button>
                </div>
              </td>
              <td>
                <div class="carac-adjustments-line" style="display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px;width:100%;min-width:0;">
                  <div class="a2e-adjustment-item" style="max-width:none;min-width:0;"><label title="Langues supplémentaires utilisées / disponibles">Langues</label><input type="text" value="{{abilityDerived.intelligence.languageQuota.display}}" title="Langues connues : {{abilityDerived.intelligence.languageQuota.knownCount}}&#10;Langues de base gratuites : {{abilityDerived.intelligence.languageQuota.freeCount}}&#10;Langues supplémentaires utilisées : {{abilityDerived.intelligence.languageQuota.used}} / {{abilityDerived.intelligence.languageQuota.capacity}}&#10;{{abilityDerived.intelligence.languageQuota.status}}" style="width:100%;min-width:0;" readonly></div>
                  <div class="a2e-adjustment-item" style="max-width:none;min-width:0;"><label title="Chance de connaître chaque sort">% sort</label><input type="text" value="{{abilityDerived.intelligence.profile.chance_sort}} %" title="Chance de connaître chaque sort" style="width:100%;min-width:0;" readonly></div>
                  <div class="a2e-adjustment-item" style="max-width:none;min-width:0;"><label title="Nombre minimum de sorts connus par niveau">Min.</label><input type="text" value="{{abilityDerived.intelligence.profile.min_sort}}" title="Nombre minimum de sorts connus par niveau" style="width:100%;min-width:0;" readonly></div>
                  <div class="a2e-adjustment-item" style="max-width:none;min-width:0;"><label title="Nombre maximum de sorts connus par niveau">Max.</label><input type="text" value="{{abilityDerived.intelligence.profile.max_sort}}" title="Nombre maximum de sorts connus par niveau" style="width:100%;min-width:0;" readonly></div>
                  <div class="a2e-adjustment-item" style="max-width:none;min-width:0;"><label title="Capacité de sorts par niveau">/ niv.</label><input type="text" value="{{abilityDerived.intelligence.profile.sort_par_niveau}}" title="Capacité de sorts par niveau" style="width:100%;min-width:0;" readonly></div>
                  <div class="a2e-adjustment-item" style="max-width:none;min-width:0;"><label title="Niveau maximal de sort accessible">Niv. max</label><input type="text" value="{{abilityDerived.intelligence.profile.niveau_sort_max}}" title="Niveau maximal de sort accessible" style="width:100%;min-width:0;" readonly></div>
                  <div class="a2e-adjustment-item" style="max-width:none;min-width:0;"><label title="Immunités aux illusions">Illusions</label><input type="text" value="{{abilityDerived.intelligence.illusionImmunitiesSummary}}" title="Niveaux d’illusions auxquels le personnage est immunisé" style="width:100%;min-width:0;" readonly></div>
                </div>
              </td>
            </tr>
