      <section class='a2e-tab-content tab tab-combat {{#if (eq activeTab "combat")}}active{{/if}}' data-group="primary" data-tab="combat">
        <div class="a2e-grid-2">
          <div class="a2e-panel">
            <h2>Défense canonique</h2>
            <div class="a2e-panel-body">
              <table class="a2e-table">
                <thead>
                  <tr><th>Élément</th><th>Valeur</th><th>Source</th></tr>
                </thead>
                <tbody>
                  {{#each combatDefense.detailRows as |row|}}
                    <tr>
                      <th>{{row.label}}</th>
                      <td>{{row.value}}</td>
                      <td>{{#if row.sourceName}}{{row.sourceName}}{{else}}—{{/if}}</td>
                    </tr>
                  {{/each}}
                  <tr><th>CA finale</th><td><b>{{combatDefense.ac_totale}}</b></td><td>Résolution canonique</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <div class="a2e-panel">
            <h2>Armes équipées</h2>
            <div class="a2e-panel-body">
              {{#if equippedWeaponRows.length}}
                <table class="a2e-table">
                  <thead>
                    <tr>
                      <th>Arme</th>
                      <th>Dégâts</th>
                      <th>Total toucher</th>
                      <th>Total dégâts</th>
                      <th>THAC0 effectif</th>
                    </tr>
                  </thead>
                  <tbody>
                    {{#each equippedWeaponRows as |row|}}
                      <tr title="Toucher : {{row.attackDetailsTitle}}&#10;Dégâts : {{row.damageDetailsTitle}}">
                        <td>
                          <b>{{row.name}}</b>
                          {{#if row.isThrown}}<div class="a2e-small">Qté : {{row.stackQuantity}}</div>{{/if}}
                          {{#if row.projectileName}}<div class="a2e-small">{{row.projectileName}} ×{{row.projectileQuantity}}</div>{{/if}}
                          {{#if row.projectileMissing}}<div class="a2e-small equip-red">Projectile manquant</div>{{/if}}
                        </td>
                        <td>{{row.damage}}</td>
                        <td><b>{{row.totalHitSigned}}</b></td>
                        <td><b>{{row.totalDamageSigned}}</b></td>
                        <td><b>{{row.thacoEffectif}}</b></td>
                      </tr>
                    {{/each}}
                  </tbody>
                </table>
              {{else}}
                <p class="a2e-muted">Aucune arme équipée.</p>
              {{/if}}
            </div>
          </div>
        </div>

        {{#if combatDefense.monk_martial}}
          <div class="a2e-panel">
            <h2>Progression martiale du moine</h2>
            <div class="a2e-panel-body">
              <table class="a2e-table">
                <tbody>
                  <tr><th>Niveau martial</th><td>{{combatDefense.monk_martial.level}}</td></tr>
                  <tr><th>Mouvement</th><td>{{combatDefense.monk_martial.move}}</td></tr>
                  <tr><th>Attaques / round</th><td>{{combatDefense.monk_martial.attacksPerRound}}</td></tr>
                  <tr><th>Dégâts main nue</th><td>{{combatDefense.monk_martial.unarmedDamage}}</td></tr>
                  <tr><th>Chute ralentie</th><td>{{combatDefense.monk_martial.slowFallText}}</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        {{/if}}

        <div class="a2e-panel">
          <h2>Armes</h2>
          <div class="a2e-panel-body">
            {{#if weaponRows.length}}
              <table class="a2e-table arme-table">
                <thead>
                  <tr>
                    <th></th>
                    <th>Arme</th>
                    <th>Équipée</th>
                    <th>Dégâts</th>
                    <th>Caractéristiques</th>
                    <th>Bonus arme</th>
                    <th>Autres bonus</th>
                    <th>Totaux</th>
                    <th>THAC0</th>
                    <th>Facteur</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each weaponRows as |row|}}
                    <tr class="item" data-item-id="{{row.id}}" title="Toucher : {{row.attackDetailsTitle}}&#10;Dégâts : {{row.damageDetailsTitle}}">
                      <td><img class="arme-img-attack" data-item-id="{{row.id}}" src="{{row.img}}" title="Attaquer avec {{row.name}}" style="width:34px;height:34px;border-radius:5px;object-fit:cover;cursor:pointer;"></td>
                      <td>
                        <b>{{row.name}}</b>
                        {{#if row.isThrown}}<div class="a2e-small">Qté : {{row.stackQuantity}}</div>{{/if}}
                        {{#if row.projectileName}}<div class="a2e-small">{{row.projectileName}} ×{{row.projectileQuantity}}</div>{{/if}}
                        {{#if row.projectileMissing}}<div class="a2e-small equip-red">Projectile manquant</div>{{/if}}
                      </td>
                      <td>{{#if row.equipped}}<i class="fas fa-check-circle equip-green"></i>{{else}}<i class="fas fa-times-circle equip-red"></i>{{/if}}</td>
                      <td>{{row.damage}}</td>
                      <td>
                        <div class="a2e-small">Toucher {{row.abilityHitLabel}} {{row.abilityHitSigned}}</div>
                        <div class="a2e-small">Dégâts {{row.abilityDamageLabel}} {{row.abilityDamageSigned}}</div>
                      </td>
                      <td>{{row.weaponHitSigned}} / {{row.weaponDamageSigned}}</td>
                      <td>
                        <div class="a2e-small">{{row.otherHitSigned}} / {{row.otherDamageSigned}}</div>
                        {{#if row.effectSummary}}<div class="a2e-small" title="{{row.effectSummary}}">Détails disponibles</div>{{/if}}
                      </td>
                      <td><b>{{row.totalHitSigned}} / {{row.totalDamageSigned}}</b></td>
                      <td>{{row.thacoEffectif}}</td>
                      <td>{{row.speed}}</td>
                      <td>
                        <div class="a2e-actions">
                          <a class="item-control item-equip a2e-action-icon a2e-equip-state-icon {{#if row.equipped}}equip-green{{else}}equip-red{{/if}}" data-action="equip" data-item-id="{{row.id}}" title="{{#if row.equipped}}Équipée — cliquer pour retirer{{else}}Non équipée — cliquer pour équiper{{/if}}"><i class="fas fa-swords"></i></a>
                          <a class="item-control a2e-action-icon" data-action="trade-item" data-item-id="{{row.id}}" title="Échanger avec un autre personnage"><i class="fas fa-handshake"></i></a>
                          <a class="item-control item-edit a2e-action-icon a2e-action-edit" data-action="edit" data-item-id="{{row.id}}" title="Éditer"><i class="fas fa-edit"></i></a>
                          <a class="item-control item-delete a2e-action-icon a2e-action-delete" data-action="delete" data-item-id="{{row.id}}" title="Supprimer"><i class="fas fa-trash"></i></a>
                        </div>
                      </td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            {{else}}
              <p class="a2e-muted">Aucune arme.</p>
            {{/if}}
          </div>
        </div>

        {{#unless isPnj}}
          <div class="a2e-panel">
            <h2>Carquois et projectiles</h2>
            <div class="a2e-panel-body">
              {{#if listeCarquois.length}}
                <table class="a2e-table add2e-quiver-table">
                  <thead>
                    <tr><th>État</th><th>Projectile</th><th>Type</th><th>Dégâts</th><th>Qté</th><th>Bonus</th><th>Récup.</th><th>Actions</th></tr>
                  </thead>
                  <tbody>
                    {{#each listeCarquois as |munition|}}
                      <tr class="item add2e-quiver-row" data-item-id="{{munition._id}}">
                        <td>{{#if munition.system.equipee}}<i class="fas fa-check-circle equip-green"></i>{{else}}<i class="fas fa-times-circle equip-red"></i>{{/if}}</td>
                        <td><b>{{munition.name}}</b></td>
                        <td>{{munition.system.sousType}}{{munition.system.sous_type}}{{munition.system.munitionType}}</td>
                        <td>{{add2eItemDisplayDamage munition}}</td>
                        <td>{{munition.system.quantite}}</td>
                        <td>{{signedNumber munition.system.bonus_hit}} / {{signedNumber munition.system.bonus_dom}}</td>
                        <td>{{#if munition.system.recuperable}}{{munition.system.taux_recuperation}}{{else}}Non{{/if}}</td>
                        <td>
                          <div class="a2e-actions">
                            <a class="item-control objet-equip a2e-action-icon a2e-equip-state-icon {{#if munition.system.equipee}}equip-green{{else}}equip-red{{/if}}"
                               data-item-id="{{munition._id}}"
                               title="{{#if munition.system.equipee}}Projectile équipé — cliquer pour retirer{{else}}Équiper ce projectile{{/if}}">
                              <i class="fas fa-bullseye"></i>
                            </a>
                            <a class="item-control a2e-action-icon" data-action="trade-item" data-item-id="{{munition._id}}" title="Échanger avec un autre personnage"><i class="fas fa-handshake"></i></a>
                            <a class="item-control item-edit a2e-action-icon a2e-action-edit" data-action="edit" data-item-id="{{munition._id}}" title="Éditer"><i class="fas fa-edit"></i></a>
                            <a class="item-control item-delete a2e-action-icon a2e-action-delete" data-action="delete" data-item-id="{{munition._id}}" title="Supprimer"><i class="fas fa-trash"></i></a>
                          </div>
                        </td>
                      </tr>
                    {{/each}}
                  </tbody>
                </table>
                <p class="a2e-small"><b>Total projectiles :</b> {{add2eConsumablesSummary.carquoisQuantity}}</p>
              {{else}}
                <p class="a2e-muted">Aucun projectile dans le carquois.</p>
              {{/if}}
            </div>
          </div>
        {{/unless}}

        <div class="a2e-panel">
          <h2>Armures, boucliers et heaumes</h2>
          <div class="a2e-panel-body">
            {{#if armorRows.length}}
              <table class="a2e-table">
                <thead><tr><th>Nom</th><th>Équipée</th><th>CA de l’objet</th><th>Contribution canonique</th><th>Actions</th></tr></thead>
                <tbody>
                  {{#each armorRows as |row|}}
                    <tr class="item" data-item-id="{{row.id}}">
                      <td><b>{{row.name}}</b></td>
                      <td>{{#if row.equipped}}<i class="fas fa-check-circle equip-green"></i>{{else}}<i class="fas fa-times-circle equip-red"></i>{{/if}}</td>
                      <td>{{row.baseAc}}</td>
                      <td title="{{row.effectSummary}}">{{row.effectSummary}}</td>
                      <td>
                        <div class="a2e-actions">
                          <a class="item-control item-equip a2e-action-icon a2e-equip-state-icon {{#if row.equipped}}equip-green{{else}}equip-red{{/if}}" data-action="equip" data-item-id="{{row.id}}" title="{{#if row.equipped}}Équipée — cliquer pour retirer{{else}}Non équipée — cliquer pour équiper{{/if}}"><i class="fas fa-shield-alt"></i></a>
                          <a class="item-control a2e-action-icon" data-action="trade-item" data-item-id="{{row.id}}" title="Échanger avec un autre personnage"><i class="fas fa-handshake"></i></a>
                          <a class="item-control item-edit a2e-action-icon a2e-action-edit" data-action="edit" data-item-id="{{row.id}}" title="Éditer"><i class="fas fa-edit"></i></a>
                          <a class="item-control item-delete a2e-action-icon a2e-action-delete" data-action="delete" data-item-id="{{row.id}}" title="Supprimer"><i class="fas fa-trash"></i></a>
                        </div>
                      </td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            {{else}}
              <p class="a2e-muted">Aucune armure.</p>
            {{/if}}
          </div>
        </div>
      </section>