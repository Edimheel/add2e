      <section class='a2e-tab-content tab tab-notes {{#if (eq activeTab "notes")}}active{{/if}}' data-group="primary" data-tab="notes">
        <div class="a2e-grid-2">
          <div class="a2e-panel">
            <h2>Description de race</h2>
            <div class="a2e-panel-body a2e-small">
              {{#if raceIdentity}}
                {{#if raceIdentity.descriptionLongue}}
                  {{{raceIdentity.descriptionLongue}}}
                {{else}}
                  {{{raceIdentity.description}}}
                {{/if}}
              {{else}}
                <p class="a2e-muted">Aucune race.</p>
              {{/if}}
            </div>
          </div>

          <div class="a2e-panel">
            <h2>Description de classe</h2>
            <div class="a2e-panel-body a2e-small">
              {{#if classIdentityRows.length}}
                {{#each classIdentityRows as |cls|}}
                  {{#if ../classProgression.isMulticlass}}<h3>{{cls.name}}</h3>{{/if}}
                  {{{cls.description}}}
                {{/each}}
              {{else}}
                <p class="a2e-muted">Aucune classe.</p>
              {{/if}}
            </div>
          </div>
        </div>

        <div class="a2e-panel">
          <h2>Notes du personnage</h2>
          <div class="a2e-panel-body">
            <textarea name="system.notes" rows="8">{{actor.system.notes}}</textarea>
          </div>
        </div>
      </section>