      <aside class="a2e-saves-square-strip a2e-saves-square-side" aria-label="Jets de sauvegarde">
        <div class="a2e-saves-square-title">
          <i class="fas fa-dice-d20"></i>
          <span>Sauv.</span>
        </div>
      <div class="a2e-save-square-grid">
        {{#each saveRows as |save|}}
          <div class="a2e-save-square a2e-save-square-{{save.index}}" data-save-key="{{save.key}}">
            <i class="{{save.icon}} roll-save" data-save="{{save.index}}" title="{{save.title}}"></i>
            <div class="a2e-save-square-label">
              {{save.label}}
            </div>
            <div class="a2e-save-square-value" title="{{save.title}}">
              <span>{{save.targetDisplay}}</span>
              {{#if save.hasBonus}}<small>({{save.bonusDisplay}})</small>{{/if}}
            </div>
          </div>
        {{/each}}
      </div>
      </aside>
