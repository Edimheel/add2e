            <tr>
              <td class="carac-label-td">
                <div class="carac-flex">
                  <i class="fas fa-dice-d20 roll-stat" data-stat="charisme" title="Jet de Charisme" style="color:#e056fd;"></i>
                  <span class="carac-short">CHA</span>
                </div>
              </td>
              <td>
                <div class="carac-control-group">
                  <button type="button" class="carac-btn moins" data-carac="charisme" tabindex="-1">−</button>
                  <div class="carac-value carac-drop-target" data-carac="charisme"
                       title="Base : {{abilityDerived.charisme.base}}&#10;Valeur finale : {{abilityDerived.charisme.total}}{{#each abilityDerived.charisme.modifiers}}&#10;{{label}} {{value}}{{/each}}">
                    <span style="font-size:1.45em;font-weight:700;line-height:1;">{{abilityDerived.charisme.total}}</span>
                    {{#if abilityDerived.charisme.hasAdjustment}}
                      <span class="carac-racial-bonus-inline">({{abilityDerived.charisme.adjustmentDisplay}})</span>
                    {{/if}}
                  </div>
                  <button type="button" class="carac-btn plus" data-carac="charisme" tabindex="-1">+</button>
                </div>
              </td>
              <td>
                <div class="carac-adjustments-line">
                  <div class="a2e-adjustment-item">
                    <label>Compagnons</label>
                    <input type="text" value="{{abilityDerived.charisme.social.followers.maximum}}" title="{{abilityDerived.charisme.social.followers.description}}" readonly>
                  </div>
                  <div class="a2e-adjustment-item">
                    <label>Loyauté</label>
                    <div style="display:flex;align-items:center;gap:3px;">
                      <input type="text" value="{{abilityDerived.charisme.social.loyalty.threshold}} %" title="{{abilityDerived.charisme.social.loyalty.description}}" readonly>
                      <button type="button" class="add2e-charisma-check" data-check="loyalty" title="Tester la loyauté" aria-label="Tester la loyauté" style="width:26px;height:24px;min-width:26px;padding:0;display:inline-flex;align-items:center;justify-content:center;">
                        <i class="fas fa-people-group"></i>
                      </button>
                    </div>
                  </div>
                  <div class="a2e-adjustment-item">
                    <label>Réaction</label>
                    <div style="display:flex;align-items:center;gap:3px;">
                      <input type="text" value="{{signedNumber abilityDerived.charisme.social.reaction.adjustment}} %" title="{{abilityDerived.charisme.social.reaction.description}}" readonly>
                      <button type="button" class="add2e-charisma-check" data-check="reaction" title="Tester la réaction initiale" aria-label="Tester la réaction initiale" style="width:26px;height:24px;min-width:26px;padding:0;display:inline-flex;align-items:center;justify-content:center;">
                        <i class="fas fa-comments"></i>
                      </button>
                    </div>
                  </div>
                </div>
              </td>
            </tr>
