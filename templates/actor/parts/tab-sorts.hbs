            {{#if add2eObjectMagicItems.length}}
              <div class="a2e-panel add2e-object-magic-panel" style="box-shadow:none;">
                <h3>Objets magiques</h3>
                <div class="a2e-panel-body">
                  {{#each add2eObjectMagicItems as |item|}}
                    <div class="a2e-panel add2e-object-magic-item" data-add2e-recharge-item data-actor-id="{{../actor._id}}" data-item-id="{{item.id}}" style="box-shadow:none;margin-bottom:8px;">
                      <h3>
                        <img src="{{item.img}}" alt="{{item.name}}" style="width:26px;height:26px;border-radius:4px;object-fit:cover;vertical-align:middle;margin-right:6px;">
                        {{item.name}}
                        {{#if item.max}}
                          <span class="add2e-magic-recharge-controls" style="float:right;display:inline-flex;align-items:center;gap:6px;">
                            <button type="button" class="add2e-magic-recharge-button" style="display:none;"><i class="fas fa-battery-half"></i> Recharger</button>
                            <span class="sort-memorize-badge" style="float:none;margin:0;">Charges : {{item.charges}} / {{item.max}}</span>
                          </span>
                        {{/if}}
                      </h3>
                      <div class="a2e-panel-body">
                        {{#if item.max}}
                          <img src="icons/svg/clockwork.svg" alt="" style="display:none" onload="(()=>{const panel=this.closest('[data-add2e-recharge-item]');if(!panel||panel.dataset.rechargeBound==='1')return;panel.dataset.rechargeBound='1';const actorId=panel.dataset.actorId;const itemId=panel.dataset.itemId;const button=panel.querySelector('.add2e-magic-recharge-button');const interval=1440;const key=`${actorId}:${itemId}`;const currentTick=()=>{const api=game.add2e?.time;const value=typeof api?.currentTick==='function'?Number(api.currentTick()):Number(game.settings?.get?.('add2e','worldTimeTick'));return Number.isFinite(value)?Math.max(0,Math.floor(value)):0;};const resolve=()=>{const actor=game.actors?.get?.(actorId);return {actor,item:actor?.items?.get?.(itemId)??null};};const refresh=async(reason='refresh')=>{const {actor,item}=resolve();if(!actor||!item){console.warn('[ADD2E][MAGIC_RECHARGE][ACTOR_RENDER][ITEM_MISSING]',{reason,actorId,itemId,actorFound:!!actor});button.style.display='none';return;}const now=currentTick();const current=Math.max(0,Number(item.system?.charges?.value??0)||0);const max=Math.max(0,Number(item.system?.charges?.max??0)||0);const rechargeable=item.system?.charges?.rechargeable===true||String(item.system?.charges?.recharge??'').toLowerCase()==='rechargeable';let anchor=Number(item.getFlag?.('add2e','lastMagicItemRechargeTick'));if(!Number.isFinite(anchor)&&rechargeable&&current<max){anchor=now;await item.setFlag?.('add2e','lastMagicItemRechargeTick',anchor);console.log('[ADD2E][MAGIC_RECHARGE][ANCHOR_INIT]',{reason,actor:actor.name,actorId,item:item.name,itemId,currentTick:now,anchor});}const elapsed=Number.isFinite(anchor)?Math.max(0,now-anchor):null;const remaining=elapsed===null?null:Math.max(0,interval-elapsed);const ready=rechargeable&&current<max&&elapsed!==null&&elapsed>=interval;const diagnostic={reason,actor:actor.name,actorId,item:item.name,itemId,profile:item.flags?.add2e?.magicItemProfile??null,rechargeable,current,max,currentTick:now,lastRechargeTick:Number.isFinite(anchor)?anchor:null,elapsedTicks:elapsed,remainingTicks:remaining,requiredTicks:interval,ready};console.log('[ADD2E][MAGIC_RECHARGE][ACTOR_RENDER]',diagnostic);button.style.display=ready?'inline-flex':'none';};button.addEventListener('click',async event=>{event.preventDefault();event.stopPropagation();const {actor,item}=resolve();const now=currentTick();console.log('[ADD2E][MAGIC_RECHARGE][CLICK]',{actor:actor?.name,actorId,item:item?.name,itemId,currentTick:now,charges:item?.system?.charges,flags:item?.flags?.add2e});if(!actor||!item)return;const current=Math.max(0,Number(item.system?.charges?.value??0)||0);const max=Math.max(0,Number(item.system?.charges?.max??0)||0);const anchor=Number(item.getFlag?.('add2e','lastMagicItemRechargeTick'));const elapsed=Number.isFinite(anchor)?Math.max(0,now-anchor):0;if(elapsed<interval){ui.notifications.warn('La recharge nécessite 24 heures de temps ADD2E.');await refresh('click-too-early');return;}const formula=String(item.system?.charges?.rechargeFormula||'1d6').trim()||'1d6';const roll=await new Roll(formula).evaluate();if(game.dice3d)await game.dice3d.showForRoll(roll);const gain=Math.max(0,Math.trunc(Number(roll.total)||0));const next=Math.min(max,current+gain);await item.update({'system.charges.value':next,'flags.add2e.lastMagicItemRechargeTick':now},{add2eInternal:true,add2eMagicRecharge:true,render:false});console.log('[ADD2E][MAGIC_RECHARGE][RESULT]',{actor:actor.name,actorId,item:item.name,itemId,formula,gain,before:current,after:next,max,currentTick:now});const recovered=Math.max(0,next-current);const content=`<div class='add2e-card add2e-magic-recharge-card'><header class='add2e-card-header'><img src='${item.img||'icons/svg/battery.svg'}' alt=''><div><h3><i class='fas fa-battery-half'></i> Recharge d’objet magique</h3><div class='add2e-card-source'>${item.name}</div></div></header><div class='add2e-card-body'><div class='add2e-book-learning-grid'><b>Formule</b><span>${formula}</span><b>Résultat</b><span>${gain}</span><b>Charges</b><span>${current} → ${next} / ${max}</span><b>Récupérées</b><span>${recovered}</span></div></div></div>`;await ChatMessage.create({speaker:ChatMessage.getSpeaker({actor}),content});ui.notifications.info(`${item.name} récupère ${recovered} charge(s).`);await refresh('after-recharge');actor.sheet?.render?.({force:true});});globalThis.__add2eMagicRechargeActorHooks??=new Map();const oldHook=globalThis.__add2eMagicRechargeActorHooks.get(key);if(oldHook!==undefined)Hooks.off('updateSetting',oldHook);const hookId=Hooks.on('updateSetting',(setting)=>{const settingKey=String(setting?.key??setting?.id??'');if(settingKey==='add2e.worldTimeTick'||settingKey.endsWith('.worldTimeTick')){console.log('[ADD2E][MAGIC_RECHARGE][TICK_UPDATE]',{actorId,itemId,settingKey,currentTick:currentTick()});refresh('tick-update');}});globalThis.__add2eMagicRechargeActorHooks.set(key,hookId);refresh('initial-render');})()">
                        {{/if}}
                        {{#if item.description}}
                          <div class="a2e-small sort-description-content" style="margin-bottom:8px;">
                            {{{item.description}}}
                          </div>
                        {{/if}}
