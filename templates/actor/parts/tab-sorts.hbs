      <section class='a2e-tab-content tab tab-sorts {{#if (eq activeTab "sorts")}}active{{/if}}' data-group="primary" data-tab="sorts">
        <div class="a2e-panel">
          <h2>
            Sorts
            {{#if add2eSpellSummaryRows.length}}
              <span class="a2e-spell-capacity-summary" title="Emplacements de sorts disponibles par liste">
                {{#each add2eSpellSummaryRows as |row|}}
                  {{#each row.levels as |level|}}
                    <span class="a2e-spell-capacity-pill">{{row.label}} N{{level.spellLevel}} {{level.count}}/{{level.max}}</span>
                  {{/each}}
                {{/each}}
              </span>
            {{/if}}
          </h2>
          <div class="a2e-panel-body">
            <div class="a2e-panel add2e-components-pouch-panel" style="box-shadow:none;">
              <h3>Sacoche de composants</h3>
              <div class="a2e-panel-body">
                {{#if listeSacocheComposants.length}}
                  <table class="a2e-table add2e-components-pouch-table">
                    <thead>
                      <tr>
                        <th>Composant</th>
                        <th style="width:90px;">Qté</th>
                        <th>Utilisé par</th>
                        <th style="width:140px;">Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      {{#each listeSacocheComposants as |component|}}
                        <tr class="item add2e-component-row" data-item-id="{{component._id}}">
                          <td>
                            <div class="add2e-component-cell" style="display:flex;align-items:center;gap:6px;min-width:0;white-space:normal;">
                              <img src="{{component.img}}" alt="{{component.name}}" style="width:26px;height:26px;min-width:26px;max-width:26px;border-radius:4px;object-fit:cover;display:inline-block;flex:0 0 26px;vertical-align:middle;">
                              <b style="display:inline;line-height:1.15;">{{component.name}}</b>
                            </div>
                          </td>
                          <td>{{component.system.quantite}}</td>
                          <td>{{componentSpellNames component ../sortsParNiveau}}</td>
                          <td>
                            <div class="a2e-actions">
                              <a class="item-control a2e-action-icon" data-action="trade-item" data-item-id="{{component._id}}" title="Échanger avec un autre personnage"><i class="fas fa-handshake"></i></a>
                              <a class="item-control item-edit a2e-action-icon a2e-action-edit" data-action="edit" data-item-id="{{component._id}}" title="Éditer"><i class="fas fa-edit"></i></a>
                              <a class="item-control item-delete a2e-action-icon a2e-action-delete" data-action="delete" data-item-id="{{component._id}}" title="Supprimer"><i class="fas fa-trash"></i></a>
                            </div>
                          </td>
                        </tr>
                      {{/each}}
                    </tbody>
                  </table>
                  <p class="a2e-small"><b>Total composants :</b> {{add2eConsumablesSummary.sacocheQuantity}}</p>
                {{else}}
                  <p class="a2e-muted">Aucun composant dans la sacoche.</p>
                {{/if}}
              </div>
            </div>

            {{#if add2ePotionRows.length}}
              <div class="a2e-panel add2e-potion-ready-panel" style="box-shadow:none;margin-bottom:8px;">
                <h3>
                  Potions prêtes
                  <span class="sort-memorize-badge" style="float:right;">Doses : {{add2ePotionQuantity}}</span>
                </h3>
                <div class="a2e-panel-body">
                  <table class="sort-table add2e-potion-ready-table">
                    <thead>
                      <tr>
                        <th style="width:42px;"></th>
                        <th>Potion</th>
                        <th>Effet</th>
                        <th style="width:110px;">Doses</th>
                      </tr>
                    </thead>
                    <tbody>
                      {{#each add2ePotionRows as |potion|}}
                        <tr class="sort-row add2e-potion-ready-row" data-item-id="{{potion.itemId}}" data-sort-id="{{potion.id}}">
                          <td class="sort-drag">
                            <img class="sort-cast-img" data-sort-id="{{potion.id}}" src="{{potion.potionImg}}" alt="{{potion.potionName}}" title="Boire {{potion.potionName}}" draggable="false" style="width:34px;height:34px;border-radius:5px;object-fit:cover;cursor:pointer;">
                          </td>
                          <td><b>{{potion.potionName}}</b></td>
                          <td>
                            <a class="sort-name-link toggle-sort-desc-chat" data-sort-id="{{potion.id}}" title="Afficher / masquer la description">{{potion.name}}</a>
                          </td>
                          <td>{{#if potion.doseMax}}{{potion.doses}} / {{potion.doseMax}}{{else}}{{potion.doses}}{{/if}}</td>
                        </tr>
                        <tr id="desc-chat-{{potion.id}}" class="sort-description">
                          <td colspan="4" class="sort-description-fullcell">
                            <div class="a2e-small sort-description-content">{{{potion.description}}}</div>
                          </td>
                        </tr>
                      {{/each}}
                    </tbody>
                  </table>
                </div>
              </div>
            {{/if}}

            {{#if add2eObjectMagicItems.length}}
              <div class="a2e-panel add2e-object-magic-panel" style="box-shadow:none;margin-bottom:8px;">
                <h3>Objets magiques</h3>
                <div class="a2e-panel-body" style="padding:4px 6px 6px;">
                  <div style="display:grid;grid-template-columns:minmax(0,1fr) 118px 32px;gap:6px;align-items:center;padding:2px 4px 3px;border-bottom:1px solid #dac276;color:#6f4b12;font-size:.76em;font-weight:900;text-transform:uppercase;line-height:1;">
                    <span>Objet</span>
                    <span style="text-align:center;">Charges</span>
                    <span style="text-align:center;">Recharge</span>
                  </div>
                  {{#each add2eObjectMagicItems as |item|}}
                    <div class="add2e-object-magic-item" data-add2e-recharge-item data-item-id="{{item.id}}" style="margin:0;border-bottom:1px solid #e4d49c;padding:0;{{#unless @first}}border-top:2px solid #c8aa5a;{{/unless}}">
                      <div style="display:grid;grid-template-columns:minmax(0,1fr) 118px 32px;gap:6px;align-items:center;min-height:30px;padding:2px 4px;background:#ead99d;">
                        <div style="min-width:0;display:flex;align-items:center;gap:5px;line-height:1.05;">
                          <img src="{{item.img}}" alt="{{item.name}}" style="width:24px;height:24px;min-width:24px;border-radius:3px;object-fit:cover;border:0;">
                          {{#if item.description}}
                            <a class="sort-name-link toggle-sort-desc-chat" data-sort-id="magic-item-{{item.id}}" title="Afficher / masquer la description de l’objet" style="font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{item.name}}</a>
                          {{else}}
                            <span style="font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{item.name}}</span>
                          {{/if}}
                        </div>
                        <div style="text-align:center;font-weight:800;line-height:1;">
                          {{#if item.max}}{{item.charges}} / {{item.max}}{{else}}—{{/if}}
                        </div>
                        <div class="add2e-magic-recharge-controls" style="display:flex;align-items:center;justify-content:center;min-width:0;">
                          {{#if item.max}}
                            <button type="button" class="add2e-magic-recharge-button" title="Recharger {{item.name}}" aria-label="Recharger {{item.name}}" style="display:none;width:26px;height:26px;min-width:26px;padding:0;margin:0;border-radius:5px;line-height:1;"><i class="fas fa-battery-half"></i></button>
                          {{/if}}
                        </div>
                      </div>
                      {{#if item.description}}
                        <div id="desc-chat-magic-item-{{item.id}}" class="sort-description add2e-object-magic-description" style="display:none;margin:0;padding:3px 6px 4px;border-top:1px dotted #dac276;">
                          <div class="a2e-small sort-description-content">{{{item.description}}}</div>
                        </div>
                      {{/if}}
                      <table class="sort-table add2e-object-magic-table" style="margin:0;border:0;">
                        <tbody>
                          {{#each item.powers as |power|}}
                            {{#if power.onUse}}
                              <tr class="sort-row add2e-object-magic-power-row" data-sort-id="{{power.id}}" style="height:30px;">
                                <td class="sort-drag" style="width:34px;padding:2px 3px;text-align:center;">
                                  <img class="sort-cast-img" data-sort-id="{{power.id}}" src="{{power.img}}" title="Activer {{power.name}}" draggable="true" style="width:26px;height:26px;border-radius:4px;object-fit:cover;cursor:pointer;margin:0;border:0;">
                                </td>
                                <td style="padding:2px 4px;line-height:1.05;">
                                  <a class="sort-name-link toggle-sort-desc-chat" data-sort-id="{{power.id}}" title="Afficher / masquer la description">{{power.name}}</a>
                                </td>
                                <td style="width:118px;padding:2px 4px;text-align:center;font-weight:800;">{{#if power.cost}}{{power.cost}}{{else}}—{{/if}}</td>
                              </tr>
                              <tr id="desc-chat-{{power.id}}" class="sort-description">
                                <td colspan="3" class="sort-description-fullcell" style="padding:3px 6px;">
                                  <div class="a2e-small sort-description-content">{{{power.description}}}</div>
                                </td>
                              </tr>
                            {{/if}}
                          {{/each}}
                        </tbody>
                      </table>
                    </div>
                  {{/each}}
                </div>
              </div>
            {{else}}
              {{#if add2eObjectMagicPowers.length}}
                <div class="a2e-panel add2e-object-magic-panel" style="box-shadow:none;margin-bottom:8px;">
                  <h3>Objets magiques</h3>
                  <div class="a2e-panel-body" style="padding:4px 6px 6px;">
                    <table class="sort-table add2e-object-magic-table" style="margin:0;">
                      <thead>
                        <tr>
                          <th style="width:34px;padding:2px 3px;"></th>
                          <th style="padding:2px 4px;">Objet / pouvoir</th>
                          <th style="width:118px;padding:2px 4px;text-align:center;">Charges</th>
                        </tr>
                      </thead>
                      <tbody>
                        {{#each add2eObjectMagicPowers as |power|}}
                          {{#if power.onUse}}
                            <tr class="sort-row add2e-object-magic-power-row" data-sort-id="{{power.id}}" style="height:30px;">
                              <td class="sort-drag" style="width:34px;padding:2px 3px;text-align:center;">
                                <img class="sort-cast-img" data-sort-id="{{power.id}}" src="{{power.img}}" title="Activer {{#if power.sourceItemName}}{{power.sourceItemName}}{{else}}{{power.name}}{{/if}}" draggable="true" style="width:26px;height:26px;border-radius:4px;object-fit:cover;cursor:pointer;margin:0;border:0;">
                              </td>
                              <td style="padding:2px 4px;line-height:1.05;">
                                <a class="sort-name-link toggle-sort-desc-chat" data-sort-id="{{power.id}}" title="Afficher / masquer la description">{{#if power.sourceItemName}}{{power.sourceItemName}}{{else}}{{power.name}}{{/if}}</a>
                              </td>
                              <td style="padding:2px 4px;text-align:center;font-weight:800;">{{#if power.max}}{{power.charges}} / {{power.max}}{{else}}—{{/if}}</td>
                            </tr>
                            <tr id="desc-chat-{{power.id}}" class="sort-description">
                              <td colspan="3" class="sort-description-fullcell" style="padding:3px 6px;">
                                <div class="a2e-small sort-description-content">
                                  {{#if power.sourceItemDescription}}{{{power.sourceItemDescription}}}{{else}}{{{power.description}}}{{/if}}
                                </div>
                              </td>
                            </tr>
                          {{/if}}
                        {{/each}}
                      </tbody>
                    </table>
                  </div>
                </div>
              {{/if}}
            {{/if}}

            {{#if add2eArcaneScrollRows.length}}
              <div class="a2e-panel add2e-scroll-ready-panel" style="box-shadow:none;margin-bottom:8px;">
                <h3>
                  Parchemins prêts
                  <span class="sort-memorize-badge" style="float:right;">Prêts : {{add2eArcaneScrollQuantity}}</span>
                </h3>
                <div class="a2e-panel-body">
                  <table class="sort-table add2e-scroll-ready-table">
                    <thead>
                      <tr>
                        <th style="width:42px;"></th>
                        <th>Sort</th>
                        <th style="width:80px;">Niveau</th>
                        <th style="width:140px;">Liste</th>
                        <th style="width:190px;">Composants</th>
                        <th style="width:115px;">Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      {{#each add2eArcaneScrollRows as |scroll|}}
                        <tr class="sort-row add2e-scroll-ready-row" data-item-id="{{scroll.itemId}}" data-spell-key="{{scroll.spellKey}}">
                          <td class="sort-drag">
                            {{#if scroll.canCast}}
                              <a class="add2e-scroll-entry-cast" data-item-id="{{scroll.itemId}}" data-spell-key="{{scroll.spellKey}}" title="Lancer {{scroll.name}} depuis le parchemin">
                                <img src="{{scroll.img}}" alt="{{scroll.name}}" draggable="false" style="width:34px;height:34px;border-radius:5px;object-fit:cover;cursor:pointer;">
                              </a>
                            {{else}}
                              <img src="{{scroll.img}}" alt="{{scroll.name}}" title="Liste de sort incompatible" draggable="false" style="width:34px;height:34px;border-radius:5px;object-fit:cover;opacity:.45;cursor:not-allowed;">
                            {{/if}}
                          </td>
                          <td>
                            <b>{{scroll.name}}</b>
                            <div class="a2e-small">
                              <a
                                class="sort-name-link"
                                data-add2e-arcane-action="view-document"
                                data-item-id="{{scroll.itemId}}"
                                data-actor-id="{{../actor._id}}"
                                title="Afficher le contenu du parchemin"
                              >{{scroll.scrollName}}</a>
                            </div>
                          </td>
                          <td>{{scroll.level}}</td>
                          <td>{{scroll.listLabel}}</td>
                          <td><span style="font-weight:700;color:#1f7a1f;">Aucune — parchemin</span></td>
                          <td>
                            <div class="a2e-actions">
                              {{#if scroll.canWrite}}
                                {{#if scroll.writeBlockedCombat}}
                                  <span class="a2e-action-icon a2e-muted" title="Copie dans le livre indisponible pendant un combat" style="opacity:.45;cursor:not-allowed;"><i class="fas fa-book-open"></i></span>
                                {{else}}
                                  <a class="a2e-action-icon a2e-action-add add2e-scroll-entry-write" data-item-id="{{scroll.itemId}}" data-spell-key="{{scroll.spellKey}}" title="Copier ce sort dans le livre personnel — hors combat"><i class="fas fa-book-open"></i></a>
                                {{/if}}
                              {{else}}
                                {{#if scroll.alreadyKnown}}
                                  <span class="a2e-action-icon a2e-muted" title="Sort déjà connu"><i class="fas fa-check"></i></span>
                                {{else}}
                                  <span class="a2e-action-icon a2e-muted" title="Liste de sort incompatible"><i class="fas fa-ban"></i></span>
                                {{/if}}
                              {{/if}}
                            </div>
                          </td>
                        </tr>
                      {{/each}}
                    </tbody>
                  </table>
                </div>
              </div>
            {{/if}}

            {{#if add2eSpellLevels.length}}
              {{#each add2eSpellLevels as |level|}}
                <div class="a2e-panel" style="box-shadow:none;">
                  <h3>Niveau {{level.spellLevel}}</h3>
                  <div class="a2e-panel-body">
                    {{#each level.groups as |group|}}
                      <div class="a2e-panel add2e-spell-list-group" style="box-shadow:none;margin-bottom:8px;">
                        <h3>
                          {{group.title}}
                          {{#if group.counter.max}}
                            <span class="sort-memorize-badge">{{group.counter.label}} : {{group.counter.count}} / {{group.counter.max}}</span>
                          {{/if}}
                        </h3>
                        <div class="a2e-panel-body">
                          {{#if group.sorts.length}}
                            <table class="sort-table">
                              <thead>
                                <tr>
                                  <th style="width:130px;">Préparer</th>
                                  <th style="width:42px;"></th>
                                  <th>Sort</th>
                                  <th style="width:140px;">École</th>
                                  <th style="width:70px;">Type</th>
                                  <th style="width:260px;">Composants</th>
                                  <th style="width:125px;">Actions</th>
                                </tr>
                              </thead>
                              <tbody>
                                {{#each group.sorts as |sort|}}
                                  <tr class="sort-row" data-sort-id="{{sort.id}}" data-spell-stable-key="{{sort.flags.add2e.stableSpellKey}}" data-spell-name="{{sort.name}}" data-spell-level="{{sort.system.niveau}}">
                                    <td>
                                      {{#if sort.entries.length}}
                                        {{#each sort.entries as |entry|}}
                                          {{#if (eq entry.key group.key)}}
                                            <div class="add2e-spell-prep-entry" style="white-space:nowrap;" data-sort-id="{{sort.id}}" data-spell-stable-key="{{sort.flags.add2e.stableSpellKey}}" data-spell-name="{{sort.name}}" data-spell-level="{{sort.system.niveau}}" data-entry-key="{{entry.key}}">
                                              <a class="a2e-action-icon a2e-action-remove a2e-spell-entry-minus" data-sort-id="{{sort.id}}" data-spell-stable-key="{{sort.flags.add2e.stableSpellKey}}" data-spell-name="{{sort.name}}" data-spell-level="{{sort.system.niveau}}" data-entry-key="{{entry.key}}" title="Retirer une préparation {{entry.label}}"><i class="fas fa-minus-circle"></i></a>
                                              <span class="sort-memorize-badge" data-add2e-memorized-count="{{entry.count}}">{{entry.count}}</span>
                                              <a class="a2e-action-icon a2e-action-add a2e-spell-entry-plus" data-sort-id="{{sort.id}}" data-spell-stable-key="{{sort.flags.add2e.stableSpellKey}}" data-spell-name="{{sort.name}}" data-spell-level="{{sort.system.niveau}}" data-entry-key="{{entry.key}}" title="Ajouter une préparation {{entry.label}}"><i class="fas fa-plus-circle"></i></a>
                                            </div>
                                          {{/if}}
                                        {{/each}}
                                      {{else}}
                                        <span class="a2e-muted">—</span>
                                      {{/if}}
                                    </td>
                                    <td class="sort-drag">
                                      <img class="sort-cast-img" data-sort-id="{{sort.id}}" data-spell-stable-key="{{sort.flags.add2e.stableSpellKey}}" src="{{sort.img}}" title="Lancer {{sort.name}}" draggable="true" style="width:34px;height:34px;border-radius:5px;object-fit:cover;cursor:pointer;">
                                    </td>
                                    <td>
                                      <a class="sort-name-link toggle-sort-desc-chat" data-sort-id="{{sort.id}}" data-spell-stable-key="{{sort.flags.add2e.stableSpellKey}}" title="Afficher / masquer la description">{{sort.name}}</a>
                                      {{#if sort.listLabel}}<div class="a2e-muted a2e-small">{{sort.listLabel}}</div>{{/if}}
                                    </td>
                                    <td>{{sort.ecole}}</td>
                                    <td>{{spellComponentTypes sort}}</td>
                                    <td>
                                      {{#if sort.has_composants_materiels_status}}
                                        <div class="add2e-spell-material-statuses" style="display:flex;flex-wrap:wrap;align-items:center;gap:3px 5px;line-height:1.25;">
                                          {{#each sort.composants_materiels_status as |component|}}
                                            <span class="add2e-spell-material-status {{#if component.available}}available{{else}}missing{{/if}}" title="{{component.title}}" style="font-weight:700;{{#if component.available}}color:#1f7a1f;{{else}}color:#b33a2e;{{/if}}">{{component.label}}{{#if component.showQuantity}} ×{{component.quantity}}{{/if}}</span>{{#unless @last}}<span class="a2e-muted">·</span>{{/unless}}
                                          {{/each}}
                                        </div>
                                      {{else}}
                                        <span class="a2e-muted">{{sort.composants_materiels}}</span>
                                      {{/if}}
                                    </td>
                                    <td>
                                      <div class="a2e-actions">
                                        {{#if sort.canWriteScroll}}
                                          {{#if (eq sort.scrollWritingGroupKey group.key)}}
                                            {{#if sort.writeScrollBlockedCombat}}
                                              <span class="a2e-action-icon a2e-muted" title="Écriture d'un parchemin indisponible pendant un combat" style="opacity:.45;cursor:not-allowed;"><i class="fas fa-pen-nib"></i></span>
                                            {{else}}
                                              <a class="a2e-action-icon a2e-action-add add2e-create-scroll-from-spell" data-sort-id="{{sort.id}}" title="Écrire un parchemin de {{sort.name}} — hors combat"><i class="fas fa-pen-nib"></i></a>
                                            {{/if}}
                                          {{/if}}
                                        {{/if}}
                                        <a class="a2e-action-icon a2e-action-edit sort-edit" data-sort-id="{{sort.id}}" title="Éditer"><i class="fas fa-edit"></i></a>
                                        <a class="a2e-action-icon a2e-action-delete sort-delete" data-sort-id="{{sort.id}}" title="Supprimer"><i class="fas fa-trash"></i></a>
                                      </div>
                                    </td>
                                  </tr>
                                  <tr id="desc-chat-{{sort.id}}" class="sort-description">
                                    <td colspan="7" class="sort-description-fullcell">
                                      <div class="a2e-small sort-description-content">
                                        {{{sort.description}}}
                                        {{#if sort.composantes}}<div><b>Composantes :</b> {{sort.composantes}}</div>{{/if}}
                                        <div><b>Composants requis :</b> {{sort.composants_materiels}}</div>
                                        {{#if sort.temps_incantation}}<div><b>Incantation :</b> {{sort.temps_incantation}}</div>{{/if}}
                                        {{#if sort.portee}}<div><b>Portée :</b> {{formatSortChamp sort.portee}}</div>{{/if}}
                                        {{#if sort.duree}}<div><b>Durée :</b> {{formatSortChamp sort.duree}}</div>{{/if}}
                                      </div>
                                    </td>
                                  </tr>
                                {{/each}}
                              </tbody>
                            </table>
                          {{else}}
                            <p class="a2e-muted">Aucun sort de cette liste dans l'acteur.</p>
                          {{/if}}
                        </div>
                      </div>
                    {{/each}}
                  </div>
                </div>
              {{/each}}
            {{else}}
              <p class="a2e-muted">Aucun sort disponible.</p>
            {{/if}}
          </div>
        </div>
      </section>