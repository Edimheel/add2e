  },
  "powers": [
    {
      "id": "misc_fixed_movement_speed",
      "label": "Vitesse de déplacement imposée",
      "category": "movement",
      "compatibility": {
        "itemTypes": [
          "objet"
        ]
      },
      "activation": {
        "type": "passive",
        "trigger": "worn-or-equipped"
      },
      "automation": "automatic",
      "parameters": {
        "movementMode": {
          "type": "choice",
          "values": [
            "ground",
            "flight",
            "swim",
            "underwater",
            "ascent",
            "descent",
            "vertical"
          ],
          "default": "ground",
          "required": true,
          "label": "Mode de déplacement",
          "description": "Choisissez le mode auquel la vitesse magique s’applique.",
          "optionLabels": {
            "ground": "Marche",
            "flight": "Vol",
            "swim": "Nage",
            "underwater": "Déplacement sous-marin",
            "ascent": "Ascension",
            "descent": "Descente",
            "vertical": "Déplacement vertical"
          }
        },
        "speed": {
          "type": "number",
          "min": 0,
          "required": true,
          "label": "Vitesse",
          "description": "Vitesse finale imposée par l’objet, en mètres par round. Exemple : 36 correspond à un déplacement AD&D de 12 pouces.",
          "placeholder": "36",
          "unit": "m/round"
        },
        "ignoreEncumbrance": {
          "type": "boolean",
          "default": false,
          "label": "Ignorer l’encombrement normal",
          "description": "Cochez cette option lorsque la vitesse magique remplace les pénalités ordinaires d’encombrement. Une pénalité spéciale propre à l’objet peut toujours être ajoutée séparément."
        }
      },
      "effects": [
        {
          "type": "movement_override",
          "label": "Vitesse de déplacement imposée",
          "target": "@movementMode",
          "value": "@speed",
          "ignoreEncumbrance": "@ignoreEncumbrance"
        }
      ],
      "source": {
        "section": "III.C, III.E",
        "page": "127, 136-138"
      },
      "description": "Impose une vitesse finale à un mode de déplacement lorsque l’objet est porté ou équipé. La vitesse est saisie en mètres par round."
    },
    {
      "id": "misc_weight_step_movement_penalty",
      "label": "Pénalité de vitesse par palier de charge",
      "category": "movement",
      "compatibility": {
        "itemTypes": [
          "objet"
        ]
      },
      "activation": {
        "type": "passive",
        "trigger": "worn-or-equipped"
      },
      "automation": "automatic",
      "parameters": {
        "movementMode": {
          "type": "choice",
          "values": [
            "ground",
            "flight",
            "swim",
            "underwater",
            "ascent",
            "descent",
            "vertical"
          ],
          "default": "ground",
          "required": true,
          "label": "Mode de déplacement",
          "description": "Choisissez le mode de déplacement pénalisé par la charge.",
          "optionLabels": {
            "ground": "Marche",
            "flight": "Vol",
            "swim": "Nage",
            "underwater": "Déplacement sous-marin",
            "ascent": "Ascension",
            "descent": "Descente",
            "vertical": "Déplacement vertical"
          }
        },
        "threshold": {
          "type": "number",
          "min": 0,
          "required": true,
          "label": "Seuil sans pénalité",
          "description": "Charge transportée autorisée avant la première réduction de vitesse.",
          "placeholder": "2000",
          "unit": "po"
        },
        "step": {
          "type": "number",
          "min": 0.01,
          "required": true,
          "label": "Poids par palier",
          "description": "Quantité de charge excédentaire nécessaire pour appliquer une pénalité supplémentaire.",
          "placeholder": "100",
          "unit": "po"
        },
        "penaltyPerStep": {
          "type": "number",
          "min": 0.01,
          "required": true,
          "label": "Pénalité par palier",
          "description": "Nombre positif de mètres retirés à la vitesse pour chaque palier dépassé.",
          "placeholder": "3",
          "unit": "m/round"
        },
        "stepRounding": {
          "type": "choice",
          "values": [
            "floor",
            "ceil",
            "round"
          ],
          "default": "floor",
          "required": true,
          "label": "Calcul des paliers",
          "description": "Détermine comment une fraction de palier est comptée.",
          "optionLabels": {
            "floor": "Paliers complets uniquement",
            "ceil": "Toute fraction compte comme un palier",
            "round": "Arrondi au palier le plus proche"
          }
        },
        "weightUnit": {
          "type": "choice",
          "values": [
            "gp"
          ],
          "default": "gp",
          "required": true,
          "label": "Unité de charge",
          "description": "Unité utilisée par le système d’encombrement AD&D.",
          "optionLabels": {
            "gp": "Pièces d’or (po)"
          }
        }
      },
      "effects": [
        {
          "type": "movement_weight_step_penalty",
          "label": "Pénalité de vitesse par palier de charge",
          "target": "@movementMode",
          "threshold": "@threshold",
          "step": "@step",
          "penaltyPerStep": "@penaltyPerStep",
          "stepRounding": "@stepRounding",
          "weightUnit": "@weightUnit"
        }
      ],
      "source": {
        "section": "III.E",
        "page": "136-138"
      },
      "description": "Réduit une vitesse par paliers lorsque la charge transportée dépasse un seuil défini par l’objet."
    }
  ],
